# Local paths — used by both `dotnet run` and `docker compose`
# Copy to .env and update paths for your machine

CHARACTERS_PATH=C:\path\to\cloud-synced\characters
EXTRA_PACKS_PATH=C:\path\to\private-packs-repo
# PCGEN_CHARACTERS_PATH=C:\path\to\pcgen_characters
# PCGen LST data set (per-publisher dirs) — ground truth for content audits
# PCGEN_DATA_PATH=C:\path\to\PCGen\data\35e\my_data_set
# Owned source PDFs (books without PCGen LSTs) — used for extraction and content audits
# SOURCE_PDFS_PATH=C:\path\to\source-pdfs
