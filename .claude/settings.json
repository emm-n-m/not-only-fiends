{
  "permissions": {
    "allow": [
      "Bash(dotnet package search Microsoft.NET.Test.Sdk --exact-match --take 1)",
      "Bash(dotnet package search xunit --exact-match --take 1)",
      "Bash(dotnet package search xunit.runner.visualstudio --exact-match --take 1)",
      "Bash(dotnet package search coverlet.collector --exact-match --take 1)",
      "Bash(dotnet package search Microsoft.NET.Test.Sdk --exact-match --take 1000)",
      "Bash(dotnet package search xunit --exact-match --take 1000)",
      "Bash(dotnet package search xunit.runner.visualstudio --exact-match --take 1000)",
      "Bash(dotnet package search coverlet.collector --exact-match --take 1000)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Skill(gap-analysis)",
