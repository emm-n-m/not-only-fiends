        {
          "$type": "GrantAbility",
          "ability": {
            "id": "weapon_and_armor_proficiency",
            "name": "Weapon and Armor Proficiency",
            "description": "Proficient with all simple weapons, plus longsword, rapier, sap, short sword, shortbow, and whip. Proficient with light armor and shields (except tower)."
          }
        },
        {
          "$type": "GrantAbility",
          "ability": {
            "id": "spells",
            "name": "Spells",
            "description": "Casts arcane spells drawn from the bard spell list, using Charisma as the casting stat. Can cast in light armor without arcane spell failure."
          }
        },
        {
          "$type": "GrantAbility",
          "ability": {
            "id": "bardic_music",
            "name": "Bardic Music",
            "description": "Can use music or poetics to produce magical effects on those nearby."
          }
        },
        {
          "$type": "GrantAbility",
          "ability": {
            "id": "countersong",
            "name": "Countersong",
            "description": "With 3 or more Perform ranks, creatures within 30 feet may use the bard's Perform check in place of saves against sonic or language-dependent magical attacks; lasts up to 10 rounds."
          }
        },
        {
          "$type": "GrantAbility",
          "ability": {
            "id": "fascinate",
            "name": "Fascinate",
            "description": "With 3 or more Perform ranks, fascinate creatures within 90 feet using a Perform check as the Will save DC; affects one additional creature per three bard levels beyond 1st."
          }
        },
        {
          "$type": "GrantAbility",
          "ability": {
            "id": "animal_companion",
            "name": "Animal Companion",
            "description": "Gain an animal companion as a druid of the same level."
          }
        },
        {
          "$type": "GrantCompanionSlot",
          "linkType": "animal_companion",
          "classFeatureType": "class_feature:animal_companion_options",
          "effectiveLevelFormula": {
            "expression": "EffectiveClassLevel(druid) + EffectiveClassLevel(druid_like_bard) + min(max(EffectiveClassLevel(ranger), EffectiveClassLevel(planar_ranger)) / 2, max(0, max(EffectiveClassLevel(ranger), EffectiveClassLevel(planar_ranger)) - 3) * 2)"
          }
        },
        {
          "$type": "GrantAbility",
          "ability": {
            "id": "nature_sense",
            "name": "Nature Sense",
            "description": "+2 bonus on Knowledge (nature) and Survival checks."
          }
        },
        {
          "$type": "GrantSkillBonus",
          "skillId": "skill:knowledge_nature",
          "value": 2
        },
        {
          "$type": "GrantSkillBonus",
          "skillId": "skill:survival",
          "value": 2
        },
        {
          "$type": "GrantAbility",
          "ability": {
            "id": "wild_empathy",
            "name": "Wild Empathy",
            "description": "Can improve the attitude of an animal, similar to a Diplomacy check."
          }
        }
      ],
      "4": [
        {
          "$type": "GrantAbility",
          "ability": {
            "id": "resist_natures_lure",
            "name": "Resist Nature's Lure",
            "description": "+4 bonus on saves against spell-like abilities of fey."
          }
        }
      ],
      "6": [
        {
          "$type": "GrantAbility",
          "ability": {
            "id": "bard_suggestion",
            "name": "Suggestion",
            "description": "With 9 or more Perform ranks, use suggestion on a creature already fascinated; Will DC 10 + half bard level + Charisma modifier. This does not consume a bardic music use."
          }
        }
      ],
      "12": [
        {
          "$type": "GrantAbility",
          "ability": {
            "id": "song_of_freedom",
            "name": "Song of Freedom",
            "description": "With 15 or more Perform ranks, concentrate and perform for 1 minute to create break enchantment at bard caster level for one target within 30 feet; cannot target self."
          }
        }
      ],
      "18": [
        {
          "$type": "GrantAbility",
          "ability": {
            "id": "bard_mass_suggestion",
            "name": "Mass Suggestion",
            "description": "With 21 or more Perform ranks, simultaneously use Suggestion on any number of creatures already fascinated."
          }
        }
      ]
