@typeparam TItem

<div class="search-select @(_open ? "open" : "")" @onfocusout="OnFocusOut" tabindex="-1">
    <input type="text"
           class="form-control @CssClass"
           placeholder="@Placeholder"
           @bind="_search"
           @bind:event="oninput"
           @bind:after="OnSearchChanged"
           @onfocus="Open"
           @onkeydown="OnKeyDown" />
    @if (_open && _filtered.Any())
    {
        <div class="search-select-dropdown">
            @foreach (var (item, idx) in _filtered.Select((item, i) => (item, i)))
            {
                var isHighlighted = idx == _highlightIndex;
                <div class="search-select-item @(isHighlighted ? "highlighted" : "") @(EqualityComparer<string>.Default.Equals(GetValue(item), Value) ? "selected" : "")"
                     title="@GetTitle(item)"
                     @onmousedown="() => Select(item)"
                     @onmousedown:preventDefault>
                    <div>@GetDisplay(item)</div>
                    @if (!string.IsNullOrWhiteSpace(GetDescription(item)))
                    {
                        <div class="search-select-description">@GetDescription(item)</div>
                    }
                </div>
            }
            @if (_truncated)
            {
                <div class="search-select-description px-2 py-1 text-muted">
                    Showing first @MaxResults of @_matchCount — type to narrow
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Enumerable.Empty<TItem>();
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Func<TItem, string> DisplaySelector { get; set; } = item => item?.ToString() ?? "";
    [Parameter] public Func<TItem, string> ValueSelector { get; set; } = item => item?.ToString() ?? "";
    [Parameter] public string Placeholder { get; set; } = "Search...";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public Func<TItem, string>? TitleSelector { get; set; }
    /// <summary>Optional rules text displayed beneath each result, rather than hidden in a native tooltip.</summary>
    [Parameter] public Func<TItem, string>? DescriptionSelector { get; set; }
    [Parameter] public int MaxResults { get; set; } = 50;

    private string _search = "";
    private bool _open;
    private int _highlightIndex = -1;
    private List<TItem> _filtered = new();

    protected override void OnParametersSet()
    {
        // If the value changed externally, update the search text to match. Only while closed:
        // whatever the user is typing outranks the bound value until they commit or leave.
        if (!_open)
        {
            if (string.IsNullOrEmpty(Value))
            {
                // Cleared externally. The repeatable pickers (Spell Mastery, per-tick feats and
                // domains) clear it after committing a pick — and they clear it to "", not null,
                // so this cannot test for null alone. Leaving the last pick in the box read as
                // "still selected" and made the next pick look like it had gone in already.
                _search = "";
            }
            else
            {
                // An unmatched value is left showing whatever is in the box: it is a content id
                // this catalogue does not carry, and blanking the field would hide that.
                var match = Items.FirstOrDefault(i => GetValue(i) == Value);
                if (match != null)
                    _search = GetDisplay(match);
            }
        }
        UpdateFiltered();
    }

    private string GetDisplay(TItem item) => DisplaySelector(item);
    private string GetValue(TItem item) => ValueSelector(item);
    private string GetTitle(TItem item) => TitleSelector?.Invoke(item) ?? "";
    private string GetDescription(TItem item) => DescriptionSelector?.Invoke(item) ?? "";

    private bool _truncated;
    private int _matchCount;

    private void UpdateFiltered()
    {
        var query = _search.Trim();
        IEnumerable<TItem> source = Items;
        if (!string.IsNullOrEmpty(query))
        {
            var terms = query.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            source = source.Where(item =>
            {
                var display = GetDisplay(item).ToLowerInvariant();
                var value = GetValue(item).ToLowerInvariant();
                return terms.All(t =>
                {
                    var tl = t.ToLowerInvariant();
                    return display.Contains(tl) || value.Contains(tl);
                });
            });
        }
        var matches = source.ToList();
        _matchCount = matches.Count;
        _truncated = matches.Count > MaxResults;
        _filtered = _truncated ? matches.Take(MaxResults).ToList() : matches;
    }

    private void OnSearchChanged()
    {
        _highlightIndex = -1;
        UpdateFiltered();
        _open = true;
    }

    private void Open()
    {
        _search = "";
        _open = true;
        _highlightIndex = -1;
        UpdateFiltered();
    }

    private void Select(TItem item)
    {
        _search = GetDisplay(item);
        _open = false;
        ValueChanged.InvokeAsync(GetValue(item));
    }

    private async Task OnFocusOut()
    {
        // Delay to allow onmousedown to fire before closing
        await Task.Delay(150);
        _open = false;

        // If the search text doesn't match a valid item, revert to current value
        var match = Items.FirstOrDefault(i =>
            GetDisplay(i).Equals(_search, StringComparison.OrdinalIgnoreCase)
            || GetValue(i).Equals(_search, StringComparison.OrdinalIgnoreCase));
        if (match != null)
        {
            _search = GetDisplay(match);
            if (GetValue(match) != Value)
                await ValueChanged.InvokeAsync(GetValue(match));
        }
        else
        {
            // Abandoned text reverts to whatever is actually selected — nothing, when there is
            // no selection (null or "").
            var current = Items.FirstOrDefault(i => GetValue(i) == Value);
            _search = current != null ? GetDisplay(current) : "";
        }
        StateHasChanged();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (!_open || !_filtered.Any()) return;

        switch (e.Key)
        {
            case "ArrowDown":
                _highlightIndex = Math.Min(_highlightIndex + 1, _filtered.Count - 1);
                break;
            case "ArrowUp":
                _highlightIndex = Math.Max(_highlightIndex - 1, 0);
                break;
            case "Enter":
                if (_highlightIndex >= 0 && _highlightIndex < _filtered.Count)
                    Select(_filtered[_highlightIndex]);
                else if (_filtered.Count == 1)
                    Select(_filtered[0]);
                break;
            case "Escape":
                _open = false;
                break;
        }
    }
}
