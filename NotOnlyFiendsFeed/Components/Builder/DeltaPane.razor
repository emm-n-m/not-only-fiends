@using NotOnlyFiendsStudio.Models
@*
    Right rail of the builder (design screen 4a). Current standing, spells-per-day
    for the primary caster, and the engine warnings, with the commit actions at the
    foot. The mock frames this as "if committed" deltas; because the builder keeps a
    fully editable timeline (no single pending tick to diff against), it shows the
    live standing instead — same information, honestly labelled.
*@
<div class="reg-delta">
    <div>
        <div class="reg-delta-label">CURRENT STANDING</div>
        <div>
            @Row("Hit points", State.HP.ToString())
            @foreach (var caster in _casters.Where(c => State.EffectiveCasterLevel(c.ClassId) > 0))
            {
                @Row($"Caster level · {ClassLabel(caster.ClassId)}", State.EffectiveCasterLevel(caster.ClassId).ToString())
            }
            @Row("Base attack", FormatSigned(State.EffectiveBAB))
            @Row("Fort / Ref / Will", $"{FormatSigned(State.EffectiveSaves.Fort)} / {FormatSigned(State.EffectiveSaves.Ref)} / {FormatSigned(State.EffectiveSaves.Will)}")
            @Row("Armor class", $"{State.AC.Total} (T {State.AC.Touch} / FF {State.AC.FlatFooted})")
            @Row("ECL", State.ECL.ToString())
        </div>
    </div>

    @{
        var slotCasters = _casters.Where(c => c.SpellsPerDay.Count > 0).ToList();
    }
    @foreach (var caster in slotCasters)
    {
        var maxSpellLevel = caster.SpellsPerDay.Keys.Max();
        <div>
            <div class="reg-delta-label">
                SPELLS PER DAY@(slotCasters.Count > 1 ? $" · {ClassLabel(caster.ClassId)}" : "")
            </div>
            <div class="reg-spd-grid">
                @foreach (var lvl in Enumerable.Range(0, maxSpellLevel + 1))
                {
                    var castable = caster.SpellsPerDay.ContainsKey(lvl);
                    var total = caster.TotalSlotsAt(lvl);
                    var bonus = caster.BonusSlotsAt(lvl);
                    var has = castable && total > 0;
                    <div class="reg-spd-cell @(has ? "" : "empty")"
                         title="@SlotBreakdown(caster, lvl)">
                        <div class="reg-spd-lvl">@lvl</div>
                        <div class="reg-spd-n">@(has ? total.ToString() : "—")</div>
                        @if (bonus > 0)
                        {
                            <div class="reg-spd-bonus">+@bonus</div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (State.Warnings.Any())
    {
        <div>
            <div class="reg-delta-label">ENGINE WARNINGS · @State.Warnings.Count</div>
            @foreach (var w in State.Warnings)
            {
                <div class="reg-delta-warn">@w.Message</div>
            }
        </div>
    }

    <div class="d-flex gap-2 mt-1">
        <button class="btn btn-success flex-fill btn-sm" @onclick="() => OnSave.InvokeAsync()">Save</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => OnEvaluate.InvokeAsync()">Re-evaluate</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CharacterState State { get; set; } = default!;
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnEvaluate { get; set; }

    /// <summary>
    /// Resolves a spellcasting class id to its display name. Optional — without it the pane falls
    /// back to the bare id, which is still better than labelling nothing.
    /// </summary>
    [Parameter] public Func<string, string>? ClassName { get; set; }

    /// Every caster, strongest first. A multiclass caster (Bard 7 / Blackguard 3) has one entry
    /// each; showing only the strongest hid the rest.
    private List<SpellcastingState> _casters = new();

    protected override void OnParametersSet()
    {
        _casters = State.Spellcasting.Values
            .OrderByDescending(s => s.CasterLevel)
            .ThenBy(s => s.ClassId, StringComparer.Ordinal)
            .ToList();
    }

    private string ClassLabel(string classId) =>
        ClassName?.Invoke(classId) ?? classId.Replace("class:", "");

    /// Tooltip explaining a slot count, so the "+2" marker says where the extra slots came from.
    private static string SlotBreakdown(SpellcastingState caster, int spellLevel)
    {
        if (!caster.SpellsPerDay.ContainsKey(spellLevel))
            return $"Level {spellLevel}: not castable yet";

        var parts = new List<string> { $"{caster.SpellsPerDay.GetValueOrDefault(spellLevel)} base" };
        var ability = caster.AbilityBonusSlots.GetValueOrDefault(spellLevel);
        if (ability > 0) parts.Add($"+{ability} {caster.CastingStat}");
        var domain = caster.DomainBonusSlots.GetValueOrDefault(spellLevel);
        if (domain > 0) parts.Add($"+{domain} domain");
        var specialty = caster.SpecialtyBonusSlots.GetValueOrDefault(spellLevel);
        if (specialty > 0) parts.Add($"+{specialty} specialty");

        return $"Level {spellLevel}: {string.Join(", ", parts)} = {caster.TotalSlotsAt(spellLevel)}";
    }

    private static string FormatSigned(int value) => value >= 0 ? $"+{value}" : value.ToString();

    private RenderFragment Row(string key, string value) => __builder =>
    {
        <div class="reg-delta-row">
            <span class="k">@key</span>
            <span class="v">@value</span>
        </div>
    };
}
