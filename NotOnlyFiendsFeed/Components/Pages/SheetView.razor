@page "/sheet"
@page "/sheet/{Id}"
@using NotOnlyFiendsStudio.Studio
@using NotOnlyFiendsStudio.Models
@using NotOnlyFiendsFeed.Services
@inject ServerContentService Content
@inject CharacterStore CharacterStore
@inject IJSRuntime JS

<PageTitle>Character Sheet</PageTitle>

<h2>Character Sheet</h2>

@if (_loading)
{
    <p>Loading...</p>
}
else if (_error != null)
{
    <p class="text-danger">@_error</p>
}
else if (_character == null)
{
    <div class="reg-panel p-4" style="max-width:560px">
        <h5 class="mb-1">No character selected</h5>
        <p class="text-muted">Open a saved character to view its sheet, or build a new one.</p>
        @if (_savedCharacters.Count > 0)
        {
            <div class="reg-rail-label mt-3">SAVED CHARACTERS</div>
            <div style="max-height:320px; overflow-y:auto" class="mt-1">
                @foreach (var c in _savedCharacters)
                {
                    <a class="d-flex justify-content-between py-1" href="@($"sheet/{Uri.EscapeDataString(c.Id)}")">
                        <span>@c.Name</span>
                        <span class="reg-mono text-muted">@(c.Sheet?.ECL is int e ? $"ECL {e}" : "")</span>
                    </a>
                }
            </div>
        }
        <div class="mt-3 d-flex gap-2">
            <a href="builder" class="btn btn-sm btn-success">Open builder</a>
            <a href="/" class="btn btn-sm btn-outline-secondary">Roster</a>
        </div>
    </div>
}
else if (_state != null && _character != null)
{
    <div class="sheet">
        <div class="tab-toolbar">
            <!-- Level Slider — a viewport control over the whole sheet, so it stays pinned
                 rather than living on one tab. -->
            <div class="level-slider mb-2">
                <label>View at HD: <strong>@_viewHD</strong> / @_character.Ticks.Count</label>
                <input type="range" min="1" max="@_character.Ticks.Count" @bind="_viewHD" @bind:event="oninput"
                       @bind:after="OnSliderChanged" class="form-range" />
            </div>

            <div class="summary-strip d-flex flex-wrap align-items-center gap-3 small border rounded bg-light px-2 py-1 mb-2">
                <span class="fw-bold">@_character.Name</span>
                <span>HD <strong>@_state.TotalHD</strong></span>
                <span>ECL <strong>@_state.ECL</strong></span>
                <span>HP <strong>@_state.HP</strong></span>
                <span>BAB <strong>@FormatSigned(_state.EffectiveBAB)</strong></span>
                <span>
                    Saves
                    <strong>@FormatSigned(_state.EffectiveSaves.Fort) /
                    @FormatSigned(_state.EffectiveSaves.Ref) /
                    @FormatSigned(_state.EffectiveSaves.Will)</strong>
                </span>
                @if (_state.Warnings.Any())
                {
                    <button class="btn btn-link btn-sm p-0 align-baseline text-danger"
                            @onclick="() => SetActiveTab(CharacterTab.Summary)">
                        @_state.Warnings.Count warning(s)
                    </button>
                }
            </div>

            <TabStrip Tabs="VisibleTabs()" ActiveTab="_activeTab" ActiveTabChanged="SetActiveTab" />
        </div>

        @* ============================== TAB: Summary ============================== *@
        @if (_activeTab == CharacterTab.Summary)
        {
        <!-- Header -->
        <div class="card mb-3">
            <div class="card-body">
                <h3>@_character.Name</h3>
                <p>
                    <strong>Race:</strong> @_state.RaceId |
                    <strong>Type:</strong> @_state.Type |
                    <strong>Size:</strong> @_state.Size |
                    <strong>HD:</strong> @_state.TotalHD |
                    <strong>ECL:</strong> @_state.ECL
                    @{
                        // Reads the race rather than state.LevelAdjustment, which coalesces null to
                        // 0 and so cannot tell "no sanctioned LA" from "LA +0".
                        var laText = RaceCatalog.DescribeLevelAdjustment(_raceDefinition);
                    }
                    @if (_raceDefinition is { LevelAdjustment: null })
                    {
                        <span class="badge bg-warning text-dark ms-1" title="Its source never printed a Level Adjustment for this race, so it was not sanctioned as a player-character option. Contributes 0 to ECL.">@laText</span>
                    }
                    else if (_state.LevelAdjustment > 0)
                    {
                        <span> (@laText)</span>
                    }
                </p>
                <p>
                    <strong>Classes:</strong>
                    @foreach (var (classId, level) in _state.ClassLevels)
                    {
                        <span class="badge bg-secondary me-1">@classId.Replace("class:", "") @level</span>
                    }
                    @if (_state.TemplateIds.Any())
                    {
                        <strong class="ms-2">Templates:</strong>
                        @foreach (var t in _state.TemplateIds)
                        {
                            <span class="badge bg-info me-1">@t.Replace("template:", "")</span>
                        }
                    }
                </p>
                @if (_state.Languages.Any())
                {
                    <p class="mb-0">
                        <strong>Languages:</strong>
                        @string.Join(", ", _state.Languages.Select(Titleise).OrderBy(l => l, StringComparer.OrdinalIgnoreCase))
                    </p>
                }
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header">Ability Scores</div>
                    <div class="card-body">
                        <table class="table table-sm">
                            <thead><tr><th>Ability</th><th>Score</th><th>Mod</th></tr></thead>
                            <tbody>
                                @foreach (var ability in Enum.GetValues<Ability>())
                                {
                                    var score = _state.AbilityScores.GetScore(ability);
                                    var mod = AbilityScoreSet.Modifier(score);
                                    <tr>
                                        <td>@ability</td>
                                        <td>@score</td>
                                        <td>@(mod >= 0 ? $"+{mod}" : mod.ToString())</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Combat Stats -->
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header">Combat</div>
                    <div class="card-body">
                        <p><strong>HP:</strong> @_state.HP</p>
                        <p>
                            <strong>BAB:</strong> +@_state.EffectiveBAB
                            @if (_state.EpicAttackBonus > 0) { <span class="text-muted">(base @_state.BaseBAB + epic @_state.EpicAttackBonus)</span> }
                        </p>
                        <p>
                            <strong>Saves:</strong>
                            Fort +@_state.EffectiveSaves.Fort |
                            Ref +@_state.EffectiveSaves.Ref |
                            Will +@_state.EffectiveSaves.Will
                            @if (_state.EpicSaveBonus > 0) { <span class="text-muted">(+@_state.EpicSaveBonus epic)</span> }
                        </p>
                        @if (_state.NaturalArmor > 0)
                        {
                            <p><strong>Natural Armor:</strong> +@_state.NaturalArmor</p>
                        }
                        @if (_state.SpellResistance.HasValue)
                        {
                            <p><strong>SR:</strong> @_state.SpellResistance</p>
                        }
                    </div>
                </div>

                <!-- Movement -->
                <div class="card mb-3">
                    <div class="card-header">Movement</div>
                    <div class="card-body">
                        @foreach (var (mode, speed) in _state.Speeds.OrderBy(entry => entry.Key))
                        {
                            <p>
                                @mode: @speed ft.@(mode == MovementMode.Fly && _state.FlyManeuverability.HasValue
                                    ? $" ({_state.FlyManeuverability.Value})"
                                    : "")
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Warnings -->
        @if (_state.Warnings.Any())
        {
            <div class="alert alert-warning">
                <h5>Warnings</h5>
                <ul>
                    @foreach (var w in _state.Warnings)
                    {
                        <li>@(w.TickIndex.HasValue ? $"HD {w.TickIndex}: " : "")@w.Message</li>
                    }
                </ul>
            </div>
        }
        }

        @* ==================== TAB: Feats & Special Abilities ==================== *@
        @if (_activeTab == CharacterTab.Feats)
        {
                <div class="card mb-3">
                    <div class="card-header">Feats (@_state.Feats.Count)</div>
                    <div class="card-body">
                        @if (_state.Feats.Any())
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var feat in _state.Feats)
                                {
                                    _registry.TryGetFeat(feat, out var featDef);
                                    <li title="@(featDef?.Description ?? "")">@(featDef?.Name ?? feat)</li>
                                }
                            </ul>
                        }
                        @if (_state.PendingFeatSlots > 0 || _state.PendingBonusFeatSlots > 0)
                        {
                            <p class="text-warning mt-2">
                                Unspent: @_state.PendingFeatSlots standard, @_state.PendingBonusFeatSlots bonus
                            </p>
                        }
                    </div>
                </div>

        <div class="row">
            @if (_state.Abilities.Any())
            {
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header">Special Abilities</div>
                        <div class="card-body">
                            <ul class="list-unstyled mb-0">
                                @foreach (var ability in _state.Abilities)
                                {
                                    <li><strong>@ability.Name</strong> — @ability.Description</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }

            @if (_state.Counters.Any())
            {
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header">Scaling Features</div>
                        <div class="card-body">
                            <ul class="list-unstyled mb-0">
                                @foreach (var c in _state.Counters)
                                {
                                    <li><strong>@FormatCounter(c.Key, c.Value)</strong></li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row">
            @if (_state.SLAs.Any())
            {
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header">Spell-Like Abilities</div>
                        <div class="card-body">
                            <ul class="list-unstyled mb-0">
                                @foreach (var sla in _state.SLAs)
                                {
                                    <li title="@(sla.Description ?? "")">
                                        @sla.Name @(sla.UsesPerDay != null ? $"({sla.UsesPerDay})" : "")
                                        @if (sla.SaveDC.HasValue)
                                        {
                                            <span class="text-muted">— DC @sla.SaveDC</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }

            @if (_state.Capabilities.Any())
            {
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header">Capabilities</div>
                        <div class="card-body">
                            <ul class="list-unstyled mb-0">
                                @foreach (var (label, detail) in GroupCapabilities(_state.Capabilities))
                                {
                                    <li><strong>@label</strong>@(detail != null ? $" — {detail}" : "")</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Resistances, DR, Immunities -->
        @if (_state.Resistances.Any() || _state.DamageReduction.Any() || _state.Immunities.Any() || _state.NaturalAttacks.Any())
        {
            <div class="row">
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header">Defenses</div>
                        <div class="card-body">
                            @if (_state.Immunities.Any())
                            {
                                <p><strong>Immunities:</strong>
                                    @foreach (var immunity in _state.Immunities.OrderBy(i => i))
                                    {
                                        <span class="badge bg-danger me-1">Immune to @Titleise(immunity)</span>
                                    }
                                </p>
                            }
                            @if (_state.Resistances.Any())
                            {
                                <p><strong>Resistances:</strong>
                                    @string.Join(", ", _state.Resistances.Select(r => $"{r.Key} {r.Value}"))
                                </p>
                            }
                            @if (_state.DamageReduction.Any())
                            {
                                <p><strong>DR:</strong>
                                    @string.Join(", ", _state.DamageReduction.Select(dr => $"{dr.Value}/{dr.BypassedBy}"))
                                </p>
                            }
                        </div>
                    </div>
                </div>
                @if (_state.NaturalAttacks.Any())
                {
                    <div class="col-md-6">
                        <div class="card mb-3">
                            <div class="card-header">Natural Attacks</div>
                            <div class="card-body">
                                <ul class="list-unstyled mb-0">
                                    @foreach (var atk in _state.NaturalAttacks)
                                    {
                                        <li>@atk.Count× @atk.Name (@atk.Damage) @(atk.IsPrimary ? "primary" : "secondary")</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        }

        @* =============================== TAB: Skills =============================== *@
        @if (_activeTab == CharacterTab.Skills)
        {
                <div class="card mb-3">
                    <div class="card-header">Skills (@_state.UnspentSkillPoints unspent pts)</div>
                    <div class="card-body">
                        @if (_state.SkillTotals.Any())
                        {
                            <table class="table table-sm">
                                <thead><tr><th>Skill</th><th>Ranks</th><th>Ability</th><th>Misc</th><th>Total</th></tr></thead>
                                <tbody>
                                    @foreach (var skill in _state.SkillTotals.Keys.OrderBy(id => SkillName(id), StringComparer.OrdinalIgnoreCase))
                                    {
                                        var skillDef = _registry.GetAllSkills().FirstOrDefault(s => s.Id == skill);
                                        var misc = _state.SkillBonuses.GetValueOrDefault(skill)
                                                   + _state.SkillSynergyBonuses.GetValueOrDefault(skill);
                                        var total = _state.SkillTotals[skill];
                                        var abilityMod = total - (_state.SkillHalfRanks.GetValueOrDefault(skill) / 2) - misc;
                                        <tr>
                                            <td title="@(skillDef?.Description ?? "")">@(skillDef?.Name ?? skill) @(_state.ClassSkills.Contains(skill) ? "(class)" : "")</td>
                                            <td>@(_state.SkillHalfRanks.GetValueOrDefault(skill) / 2.0)</td>
                                            <td>@FormatSigned(abilityMod)</td>
                                            <td title="@MiscBreakdown(skill)">@FormatSigned(misc)</td>
                                            <td><strong>@FormatSigned(total)</strong></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted">No skill ranks allocated</p>
                        }
                    </div>
                </div>
        }

        @* =============================== TAB: Spells =============================== *@
        @* Domains sit here on the sheet (they explain the bonus spell slots), but on
           the builder they are a class-feature picker on Progression. The asymmetry is
           deliberate, not an oversight. *@
        @if (_activeTab == CharacterTab.Spells)
        {
        <div class="row">
            @if (_state.Domains.Any())
            {
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header">Domains</div>
                        <div class="card-body">
                            <ul class="list-unstyled mb-0">
                                @foreach (var domainId in _state.Domains.OrderBy(id => id, StringComparer.Ordinal))
                                {
                                    _registry.TryGetDomain(domainId, out var domain);
                                    var owner = _state.DomainOwners.GetValueOrDefault(domainId);
                                    <li>
                                        <strong>@(domain?.Name ?? domainId.Replace("domain:", ""))</strong>
                                        <span class="text-muted">— @(string.IsNullOrEmpty(owner) ? "race/template" : owner.Replace("class:", ""))</span>
                                        @if (!string.IsNullOrWhiteSpace(domain?.Description))
                                        {
                                            <div class="small">@domain.Description</div>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Spellcasting -->
        @if (_state.Spellcasting.Any())
        {
            <div class="card mb-3">
                <div class="card-header">Spellcasting</div>
                <div class="card-body">
                    @foreach (var (classId, sc) in _state.Spellcasting)
                    {
                        <h5>@classId.Replace("class:", "") (CL @sc.CasterLevel, @sc.CastingType, @sc.CastingStat)</h5>
                        <p>
                            <strong>Spells/Day:</strong>
                            @string.Join(" / ", sc.SpellsPerDay.OrderBy(kv => kv.Key).Select(kv =>
                            {
                                var domain = sc.DomainBonusSlots.GetValueOrDefault(kv.Key);
                                var specialty = sc.SpecialtyBonusSlots.GetValueOrDefault(kv.Key);
                                var extra = (domain > 0 ? $"+{domain}D" : "") + (specialty > 0 ? $"+{specialty}S" : "");
                                return $"{kv.Key}th:{kv.Value}{extra}";
                            }))
                            @if (sc.DomainBonusSlots.Any() || sc.SpecialtyBonusSlots.Any())
                            {
                                <span class="text-muted small">
                                    (@(sc.DomainBonusSlots.Any() ? "D = domain slot" : "")@(sc.DomainBonusSlots.Any() && sc.SpecialtyBonusSlots.Any() ? ", " : "")@(sc.SpecialtyBonusSlots.Any() ? "S = specialty school slot" : ""))
                                </span>
                            }
                        </p>
                        @if (sc.SpellsKnown != null)
                        {
                            <p>
                                <strong>Spells Known:</strong>
                                @string.Join(" / ", sc.SpellsKnown.OrderBy(kv => kv.Key).Select(kv => $"{kv.Key}th:{kv.Value}"))
                            </p>
                        }
                        else if (sc.Acquisition == SpellAcquisition.FullList)
                        {
                            <p class="text-muted mb-1">
                                <em>Prepares from the entire class list; no spells are chosen at level-up.</em>
                            </p>
                        }
                        else if (sc.Acquisition == SpellAcquisition.Spellbook)
                        {
                            var specialty = WizardSchools.Specialty(_state);
                            var givenUp = WizardSchools.ProhibitedSchools(_state);
                            var freeCantrips = WizardSchools.AutomaticCantrips(_registry.GetAllSpells(), classId, _state).Count();
                            <p class="text-muted mb-1">
                                <em>
                                    Prepares from a spellbook holding @freeCantrips 0-level spells@(givenUp.Count > 0 ? " (those of given-up schools excluded)" : "")
                                    plus the spells below.
                                </em>
                            </p>
                            <p class="mb-1">
                                <strong>School:</strong>
                                @(specialty != null ? Titleise(specialty) : "Universalist (no specialty)")
                                @if (givenUp.Count > 0)
                                {
                                    <span class="text-muted">
                                        — gave up @string.Join(", ", givenUp.Select(Titleise).OrderBy(s => s, StringComparer.OrdinalIgnoreCase))
                                    </span>
                                }
                            </p>
                        }
                        else if (sc.Acquisition == SpellAcquisition.Developed)
                        {
                            <p class="text-muted mb-1">
                                <em>Epic spells are acquired individually through development and use open epic spell slots.</em>
                            </p>
                        }
                        @if (sc.SelectedSpells.Any())
                        {
                            <p class="mb-1"><strong>Selected Spells:</strong></p>
                            <ul class="mb-3">
                                @foreach (var group in sc.SelectedSpells.OrderBy(s => s.SpellLevel).GroupBy(s => s.SpellLevel))
                                {
                                    <li>@($"{group.Key}th: ")@foreach (var s in group)
                                    {
                                        _registry.TryGetSpell(s.SpellId, out var spDef);
                                        <span title="@(spDef?.Description ?? "")">@(spDef?.Name ?? s.SpellId)</span>@(s != group.Last() ? ", " : "")
                                    }</li>
                                }
                            </ul>
                        }
                    }
                </div>
            </div>
        }
        }
    </div>
}
