@page "/builder"
@page "/builder/{Id}"
@using NotOnlyFiendsStudio.Studio
@using NotOnlyFiendsStudio.Models
@using NotOnlyFiendsFeed.Services
@inject ServerContentService Content
@inject CharacterStore CharacterStore
@inject BrowserFileService FileService
@inject AgentApiService Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Character Builder</PageTitle>

@if (_loading)
{
    <p>Loading content...</p>
}
else if (_error != null)
{
    <p class="text-danger">@_error</p>
}
else
{
    <!-- Actions -->
    <div class="row mb-3">
        <div class="col d-flex flex-wrap gap-2 align-items-start">
            <button class="btn btn-primary" @onclick="EvaluateCharacter">Evaluate</button>
            <button class="btn btn-success" @onclick="SaveCharacter">Save</button>
            <button class="btn btn-outline-success" @onclick="DownloadCharacter">Download</button>
            @if (CharacterStore.IsConfigured)
            {
                <div>
                    <button class="btn btn-outline-secondary" @onclick="ToggleOpenPicker">Open...</button>
                    @if (_showOpenPicker)
                    {
                        <div class="mt-1" style="min-width: 280px;">
                            <SearchSelect TItem="CharacterFileInfo"
                                          Items="_availableCharacters"
                                          Value="@_characterStoreId"
                                          ValueChanged="OpenFromStore"
                                          DisplaySelector="@(c => c.Name)"
                                          ValueSelector="@(c => c.Id)"
                                          Placeholder="Search saved characters..." />
                            <button class="btn btn-sm btn-link p-0 mt-1" @onclick="OpenFile">Open from file instead...</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <button class="btn btn-outline-secondary" @onclick="OpenFile">Open...</button>
            }
            <button class="btn btn-outline-info" @onclick="ViewSheet">View Sheet</button>
        </div>
    </div>

    @if (_statusMessage != null)
    {
        <div class="alert @(_statusIsError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2" role="alert">
            @_statusMessage
            <button type="button" class="btn-close" @onclick="() => _statusMessage = null"></button>
        </div>
    }

    @* Must stay outside every tab: BrowserFileService looks this element up by id, so
       hiding it behind a pane would break "Open from file" on every other tab. *@
    <!-- Hidden file input for Open -->
    <input type="file" id="file-open-input" accept=".json" style="display:none" />

    @if (_state == null)
    {
        <div class="text-muted small mb-2">Not evaluated yet.</div>
    }
    else
    {
        <CharacterHeaderBar State="_state"
                            Name="@_character.Name"
                            Subtitle="@HeaderSubtitle()"
                            ClassName="DriverName"
                            OnNavigate="SetActiveTab" />
    }

    <div class="tab-toolbar reg-tabs">
        <TabStrip Tabs="VisibleTabs()" ActiveTab="_activeTab" ActiveTabChanged="SetActiveTab" />
    </div>

    @* ======================= TAB: Summary & Progression ======================= *@
    @if (_activeTab == CharacterTab.Summary)
    {
    <!-- Step 1: Character Name & Race -->
    <div class="card mb-3">
        <div class="card-header">Character Setup</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" @bind="_character.Name" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Alignment</label>
                    <select class="form-select" value="@_character.Alignment" @onchange="OnAlignmentChanged">
                        @foreach (var a in Enum.GetValues<Alignment>())
                        {
                            <option value="@a">@FormatAlignment(a)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Gender</label>
                    @* Free text on the character, so an imported value that is not one of these
                       still shows and is kept on save rather than being snapped to an option. *@
                    <select class="form-select" value="@_character.Gender" @onchange="OnGenderChanged">
                        <option value="">—</option>
                        @foreach (var g in CharacterGenders.Suggested)
                        {
                            <option value="@g">@g</option>
                        }
                        @if (!string.IsNullOrWhiteSpace(_character.Gender)
                             && !CharacterGenders.Suggested.Contains(_character.Gender))
                        {
                            <option value="@_character.Gender">@_character.Gender</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Race</label>
                    <SearchSelect TItem="RaceDefinition"
                                  Items="@RaceCatalog.ForPicker(_races, _showNonPcRaces, _character.RaceId)"
                                  Value="@_character.RaceId"
                                  ValueChanged="(v) => { _character.RaceId = v ?? _character.RaceId; OnCharacterChanged(); }"
                                  DisplaySelector="@(r => r.Name + RaceCatalog.NonPcMarker(r))"
                                  ValueSelector="@(r => r.Id)"
                                  TitleSelector="@(r => RaceCatalog.IsSanctionedPcRace(r) ? r.Description : $"Not sanctioned as a player-character race by its source — no Level Adjustment is printed for it. {r.Description}")"
                                  Placeholder="Search races..." />
                    <div class="form-check form-check-inline mt-1">
                        <input class="form-check-input" type="checkbox" id="show-non-pc-races"
                               checked="@_showNonPcRaces" @onchange="OnShowNonPcRacesChanged" />
                        <label class="form-check-label small text-muted" for="show-non-pc-races">
                            Show non-PC races (@_nonPcRaceCount)
                        </label>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Templates</label>

                            <SearchSelect TItem="TemplateDriver"
                                          Items="_templates"
                                          Value="@_selectedTemplate"
                                          ValueChanged="@((v) => { _selectedTemplate = v ?? string.Empty; })"
                                  DisplaySelector="@(t => t.Name)"
                                  ValueSelector="@(t => t.Id)"
                                  Placeholder="Search templates..." />
                    @if (!string.IsNullOrEmpty(_selectedTemplate) && !_character.TemplateIds.Contains(_selectedTemplate))
                    {
                        <button class="btn btn-sm btn-outline-primary mt-1" @onclick="AddTemplate">Add Template</button>
                    }
                    @foreach (var t in _character.TemplateIds)
                    {
                        var tDef = _templates.FirstOrDefault(td => td.Id == t);
                        <span class="badge bg-info me-1 mt-1 d-inline-flex align-items-center gap-1" title="@(t)">@(tDef?.Name ?? t) <button type="button" class="btn btn-sm p-0 border-0 text-white" style="font-size: 0.85em; line-height: 1;" @onclick="() => RemoveTemplate(t)">&times;</button></span>
                        @if (tDef is not null)
                        {
                            @* Acquisition is event data the player picks — a tome has no
                               prerequisites yet lands at a specific point, and so does an
                               ascension. Blank means inherited: applies from creation. *@
                            <span class="d-inline-flex align-items-center gap-1 me-2 mt-1" title="The HD this template was acquired at. Its effects apply forward from that level; blank means it applies from creation.">
                                <small class="text-muted">acquired at HD</small>
                                <input type="number" class="form-control form-control-sm d-inline-block" style="width: 4.5rem"
                                       min="1" max="@(_character.Ticks.Count + 1)"
                                       value="@(_character.TemplateAcquisitionHD.TryGetValue(t, out var acquiredAt) ? acquiredAt : (int?)null)"
                                       @onchange="(e) => SetTemplateAcquisitionHD(t, e)" />
                            </span>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Step 2: Base Ability Scores -->
    <div class="card mb-3">
        <div class="card-header">Base Ability Scores (pre-racial)</div>
        <div class="card-body">
            <div class="row">
                @foreach (var ability in Enum.GetValues<Ability>())
                {
                    var raceBonus = GetRaceAbilityModifier(ability);
                    var templateBonus = GetTemplateAbilityModifier(ability);
                    var creationTotal = _character.BaseAbilityScores.GetScore(ability) + raceBonus + templateBonus;
                    <div class="col-2">
                        <label class="form-label">@ability</label>
                        <input type="number" class="form-control" min="1" max="40"
                               value="@_character.BaseAbilityScores.GetScore(ability)"
                               @onchange="(e) => SetAbilityScore(ability, e)" />
                        <div class="form-text">
                            Race @FormatSigned(raceBonus) | Template @FormatSigned(templateBonus) | Start @creationTotal
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Step 2b: Languages -->
    var raceForLanguages = SelectedRace();
    var offeredLanguages = OfferedBonusLanguages();
    var languageAllowance = LanguageCatalog.Allowance(GetStartingIntelligence());
    var importedLanguagePicks = ImportedBonusLanguages();
    var languagePicksUsed = LanguagePicksUsed();

    var grantedLanguageSlots = GrantedLanguageSlots();

    @if ((raceForLanguages is not null && (raceForLanguages.AutomaticLanguages.Count > 0 || offeredLanguages.Count > 0))
        || _character.SourceLanguageIds.Count > 0
        || grantedLanguageSlots > 0)
    {
        <div class="card mb-3">
            <div class="card-header">
                Languages
                <span class="float-end small text-muted">
                    @languagePicksUsed / @languageAllowance bonus picks used
                </span>
            </div>
            <div class="card-body">
                @if (raceForLanguages is not null && raceForLanguages.AutomaticLanguages.Count > 0)
                {
                    <div class="mb-2">
                        <strong class="small">Automatic:</strong>
                        @foreach (var id in raceForLanguages.AutomaticLanguages)
                        {
                            <span class="badge bg-secondary me-1">@LanguageName(id)</span>
                        }
                    </div>
                }
                @if (_character.SourceLanguageIds.Count > 0)
                {
                    <div class="mb-2">
                        <strong class="small">Imported/source:</strong>
                        @foreach (var id in _character.SourceLanguageIds)
                        {
                            <span class="badge bg-info text-dark me-1">@LanguageName(id)</span>
                        }
                    </div>
                    <div class="form-text mb-2">
                        Preserved from the imported character. The source does not say which were
                        starting-Intelligence picks, so @(importedLanguagePicks.Count == 0
                            ? "none are credited against the bonus picks below"
                            : $"the first {importedLanguagePicks.Count} the race offers are credited against the bonus picks below") —
                        the character already speaks all of them either way.
                    </div>
                }
                @if (grantedLanguageSlots > 0)
                {
                    <div class="mb-2 border-top pt-2">
                        <strong class="small">Granted:</strong>
                        <span class="float-end small text-muted">
                            @_character.GrantedLanguageIds.Count / @grantedLanguageSlots granted slot(s) used
                        </span>
                        @foreach (var source in GrantedLanguageSources())
                        {
                            <div class="form-text">@source</div>
                        }
                        <div class="d-flex flex-wrap gap-3 mt-1">
                            @foreach (var language in OfferedGrantedLanguages())
                            {
                                var takenByGrant = _character.GrantedLanguageIds.Contains(language.Id);
                                var grantAtLimit = !takenByGrant
                                    && _character.GrantedLanguageIds.Count >= grantedLanguageSlots;
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           id="@($"granted-lang-{language.Id}")"
                                           checked="@takenByGrant" disabled="@grantAtLimit"
                                           @onchange="() => ToggleGrantedLanguage(language.Id)" />
                                    <label class="form-check-label @(grantAtLimit ? "text-muted" : "")"
                                           for="@($"granted-lang-{language.Id}")" title="@language.Description">
                                        @language.Name
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (languageAllowance == 0)
                {
                    <div class="form-text">
                        Bonus languages are granted one per point of starting Intelligence modifier.
                        This character's starting Intelligence is @GetStartingIntelligence(), so there are none to spend.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var language in offeredLanguages)
                        {
                            var imported = importedLanguagePicks.Contains(language.Id);
                            var chosen = imported || _character.BonusLanguageIds.Contains(language.Id);
                            var atLimit = !chosen && languagePicksUsed >= languageAllowance;
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="@($"lang-{language.Id}")"
                                       checked="@chosen" disabled="@(imported || atLimit)"
                                       @onchange="() => ToggleBonusLanguage(language.Id)" />
                                <label class="form-check-label @(imported || atLimit ? "text-muted" : "")"
                                       for="@($"lang-{language.Id}")"
                                       title="@(imported ? $"Credited from the import — {language.Description}" : language.Description)">
                                    @language.Name
                                </label>
                            </div>
                        }
                    </div>
                    @if (raceForLanguages?.BonusLanguagesAny == true)
                    {
                        <div class="form-text mt-2">
                            @raceForLanguages.Name may take any language except secret ones such as Druidic.
                        </div>
                    }
                }
            </div>
        </div>
    }

    }
    @* ===================== end TAB: Summary & Progression ===================== *@

    @* ===================== HD TIMELINE — shared by five tabs =====================
       One loop, not five. Each tab renders the same tick list but shows only its own
       facet, and skips the ticks that have nothing to show for it. *@
    @if (IsTimelineTab(_activeTab))
    {
    <div class="reg-builder-grid">
        <aside class="reg-builder-spine">
            @if (_state != null)
            {
                <HdSpine Character="_character" State="_state" DriverNames="_driverNames"
                         UnansweredAcquisitions="UnansweredTemplateAcquisitions()" />
            }
        </aside>
        <div class="reg-builder-main">
    <!-- Step 3: HD Timeline -->
    <div class="card mb-3">
        <div class="card-header">
            @TimelineHeading(_activeTab)
            (@VisibleTickCount(_activeTab) of @_character.Ticks.Count HD)
            <div class="float-end d-flex align-items-center gap-1">
                @* The safety valve for every skip heuristic above — any tick a facet filter
                   wrongly hides is one checkbox away. *@
                <div class="form-check form-check-inline mb-0 me-1">
                    <input class="form-check-input" type="checkbox" id="show-all-hd"
                           checked="@_showAllTicks" @onchange="ToggleShowAllTicks" />
                    <label class="form-check-label small text-muted" for="show-all-hd">Show all HD</label>
                </div>
                @if (_character.Ticks.Count > 0)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleAllHdTicks">
                        @(_expandedTicks.Count == _character.Ticks.Count ? "Collapse All" : "Expand All")
                    </button>
                }
                <input type="number" class="form-control form-control-sm" style="width:60px" min="1" max="20" @bind="_addHdCount" />
                <select class="form-select form-select-sm" style="width:auto" @bind="_addHdDriverId">
                    @foreach (var d in _drivers)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleDriverPreviews">
                    @(_showDriverPreviews ? "Hide previews" : "Preview next HD")
                </button>
                <button class="btn btn-sm btn-success" @onclick="AddTick">+ Add HD</button>
            </div>
        </div>
        <div class="card-body">
            @if (_showDriverPreviews && _state != null)
            {
                <div class="mb-3">
                    <DriverPreviewGrid NextHd="_previewNextHd"
                                       Previews="_driverPreviews"
                                       Current="_state"
                                       OnChoose="ChooseDriverFromPreview" />
                </div>
            }
            @for (int i = 0; i < _character.Ticks.Count; i++)
            {
                var index = i;
                var tick = _character.Ticks[index];
                var hdNum = index + 1;
                // Captures first, skip second: the loop variable must be captured before any
                // continue so the closure-capture pattern below stays obvious.
                if (!_showAllTicks && !TickShowsFacet(index, _activeTab)) { continue; }

                @* @key on the Tick itself, not the index: once ticks can be skipped the n-th
                   rendered row is no longer tick n, and positional matching would carry a
                   SearchSelect's typed text from one HD to another. *@
                <div class="reg-tick" @key="tick">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <button class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="() => ToggleHdTick(index)" title="@(_expandedTicks.Contains(index) ? "Collapse" : "Expand")">
                                @(_expandedTicks.Contains(index) ? "\u25BC" : "\u25B6")
                            </button>
                        </div>
                        <div class="col-auto">
                            <strong>HD @hdNum</strong>
                            @if (IsAbilityIncreaseDue(index))
                            {
                                @if (tick.Choices.AbilityIncrease != null)
                                {
                                    <span class="badge bg-success ms-1">+1 @tick.Choices.AbilityIncrease</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark ms-1">Ability +1 needed</span>
                                }
                            }
                        </div>
                        @if (_expandedTicks.Contains(index))
                        {
                            <div class="col-md-3">
                                <SearchSelect TItem="Driver"
                                              Items="_drivers"
                                              Value="@tick.DriverId"
                                              ValueChanged="(v) => SetTickDriver(index, v)"
                                              DisplaySelector="@(d => d.Name)"
                                              ValueSelector="@(d => d.Id)"
                                              CssClass="form-control-sm"
                                              Placeholder="Search classes..." />
                            </div>
                            @if (IsAbilityIncreaseDue(index))
                            {
                                <div class="col-md-2">
                                    <select class="form-select form-select-sm"
                                            value="@(tick.Choices.AbilityIncrease?.ToString() ?? "")"
                                            @onchange="(e) => SetAbilityIncrease(index, e)">
                                        <option value="">Ability +1...</option>
                                        @foreach (var ab in Enum.GetValues<Ability>())
                                        {
                                            <option value="@ab">@ab</option>
                                        }
                                    </select>
                                </div>
                            }
                            <div class="col-auto">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveTick(index)">Remove</button>
                            </div>
                        }
                        else
                        {
                            <div class="col text-muted small">@CollapsedSummary(index, _activeTab)</div>
                        }
                    </div>

                    @if (_expandedTicks.Contains(index))
                    {
                    @* Declared before the facet blocks: the Summary facet's domain and
                       Advance-Spellcasting panels and the Spells facet both read it. *@
                    var casterInfo = GetTickCasterInfo(index);

                    @* ----------------------------- facet: Feats ----------------------------- *@
                    @if (_activeTab == CharacterTab.Feats)
                    {
                    <!-- Feat selection for this tick -->
                    @if (tick.Choices.FeatIds != null && tick.Choices.FeatIds.Any())
                    {
                        <div class="mt-1">
                            <small class="text-muted">Feats:</small>
                            @foreach (var feat in tick.Choices.FeatIds.ToList())
                            {
                                var featId = feat;
                                var featDef = _feats.FirstOrDefault(f => f.Id == featId);
                                var featLabel = FormatFeatLabel(featId, featDef);
                                <span class="badge bg-secondary me-1" title="@(featDef?.Description ?? featId)">@featLabel <button type="button" class="btn btn-sm p-0 border-0 text-white" style="font-size: 0.85em; line-height: 1;" @onclick="() => RemoveFeatFromTick(index, featId)">&times;</button></span>
                            }
                        </div>
                    }
                    <div class="mt-1">
                        <div class="d-flex align-items-center gap-1" style="max-width: 600px;">
                            <SearchSelect TItem="FeatDefinition"
                                          Items="GetTickFeats(index)"
                                          Value="@FeatInput(index)"
                                          ValueChanged="@((v) => { _featInputs[index] = v ?? string.Empty; _featSelectionInputs.Remove(index); })"
                                          DisplaySelector="@(f => f.Name + (f.SelectionRequired != null ? $" ({f.SelectionRequired}...)" : ""))"
                                          ValueSelector="@(f => f.Id)"
                                          TitleSelector="@(f => f.Description)"
                                          DescriptionSelector="@(f => f.Description)"
                                          CssClass="form-control-sm"
                                          Placeholder="Search feats..." />
                            @{
                                var selectedFeatDef = _feats.FirstOrDefault(f => f.Id == FeatInput(index));
                            }
                            @if (selectedFeatDef?.SelectionRequired == "school")
                            {
                                <select class="form-select form-select-sm" style="width:auto"
                                        value="@FeatSelectionInput(index)" @onchange="(e) => SetFeatSelectionInput(index, e)">
                                    <option value="">School...</option>
                                    @foreach (var school in _spellSchools)
                                    {
                                        <option value="@school">@school</option>
                                    }
                                </select>
                            }
                            else if (selectedFeatDef?.SelectionRequired == "skill")
                            {
                                <select class="form-select form-select-sm" style="width:auto"
                                        value="@FeatSelectionInput(index)" @onchange="(e) => SetFeatSelectionInput(index, e)">
                                    <option value="">Skill...</option>
                                    @foreach (var skill in _skills)
                                    {
                                        <option value="@skill.Id">@skill.Name</option>
                                    }
                                </select>
                            }
                            else if (selectedFeatDef?.SelectionRequired == "weapon")
                            {
                                <input type="text" class="form-control form-control-sm" style="width:150px"
                                       placeholder="Weapon..."
                                       value="@FeatSelectionInput(index)" @onchange="(e) => SetFeatSelectionInput(index, e)" />
                            }
                            else if (selectedFeatDef?.SelectionRequired != null)
                            {
                                <input type="text" class="form-control form-control-sm" style="width:180px"
                                       placeholder="@($"{selectedFeatDef.SelectionRequired.Replace('_', ' ')}...")"
                                       value="@FeatSelectionInput(index)" @onchange="(e) => SetFeatSelectionInput(index, e)" />
                            }
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => AddFeatToTick(index)">Add</button>
                        </div>
                    </div>
                    }
                    @* --------------------------- end facet: Feats --------------------------- *@

                    @* -------- facet: Summary (level-up decisions made at this HD) -------- *@
                    @if (_activeTab == CharacterTab.Summary)
                    {
                    @* Domain Selection *@
                    @if (casterInfo?.PendingDomainSelections > 0)
                    {
                        <div class="mt-2">
                            <small class="text-muted">Domain selection (@(casterInfo.PendingDomainSelections) remaining):</small>
                            <div class="d-flex align-items-center gap-1 mt-1" style="max-width: 400px;">
                                <SearchSelect TItem="DomainDefinition"
                                              Items="_domains"
                                              Value="@DomainInput(index)"
                                              ValueChanged="@((v) => { _domainInputs[index] = v ?? string.Empty; })"
                                              DisplaySelector="@(d => d.Name)"
                                              ValueSelector="@(d => d.Id)"
                                              TitleSelector="@(d => d.Description)"
                                              DescriptionSelector="@(d => d.Description)"
                                              CssClass="form-control-sm"
                                              Placeholder="Search domains..." />
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => AddDomainToTick(index, DomainInput(index))">Add</button>
                            </div>
                        </div>
                    }
                    var tickDomainChoices = new List<(string DomainId, string ChoiceKey)>();
                    tickDomainChoices.AddRange((tick.Choices.ClassFeatureChoices?.GetValueOrDefault("domains") ?? new())
                        .Select(domainId => (domainId, "domains")));
                    tickDomainChoices.AddRange((tick.Choices.ClassFeatureChoices?.GetValueOrDefault("imported_source_domains") ?? new())
                        .Select(domainId => (domainId, "imported_source_domains")));
                    @if (tickDomainChoices.Count > 0)
                    {
                        <div class="mt-1">
                            <small class="text-muted">Domains:</small>
                            @foreach (var domainChoice in tickDomainChoices)
                            {
                                var did = domainChoice.DomainId;
                                var domainDef = _domains.FirstOrDefault(d => d.Id == did);
                                <span class="badge bg-primary me-1" title="@(domainDef?.Description ?? did)">
                                    @(domainDef?.Name ?? did.Replace("domain:", ""))
                                    @if (domainChoice.ChoiceKey == "imported_source_domains")
                                    {
                                        <span> (source-granted)</span>
                                    }
                                    <button class="btn-close btn-close-white btn-sm" @onclick="() => RemoveDomainFromTick(index, did, domainChoice.ChoiceKey)"></button>
                                </span>
                            }
                        </div>
                    }
                    @if (tickDomainChoices.Any(choice => choice.DomainId == "domain:war"))
                    {
                        var warWeapon = tick.Choices.ClassFeatureChoices?.GetValueOrDefault("war_favored_weapon")?.FirstOrDefault() ?? "";
                        <div class="mt-2">
                            <small class="text-muted">War domain favored weapon:</small>
                            <SearchSelect TItem="EquipmentDefinition"
                                          Items="@_equipmentCatalog.Where(e => e.Category == EquipmentCategory.Weapon)"
                                          Value="@warWeapon"
                                          ValueChanged="@((v) => SetWarFavoredWeapon(index, v))"
                                          DisplaySelector="@(e => e.Name)"
                                          ValueSelector="@(e => e.Id)"
                                          TitleSelector="@(e => e.Description ?? e.Name)"
                                          DescriptionSelector="@(e => e.Description ?? "")"
                                          CssClass="form-control-sm"
                                          Placeholder="Choose weapon..." />
                        </div>
                    }

                    @* Advance Spellcasting choice (prestige classes with multiple eligible classes) *@
                    @if (casterInfo?.NeedsAdvanceSpellcastingChoice == true && casterInfo.Spellcasting.Count >= 2)
                    {
                        <div class="mt-2">
                            <small class="text-warning">Advance Spellcasting: choose which class to advance</small>
                            <select class="form-select form-select-sm mt-1" style="max-width:300px"
                                    value="@(tick.Choices.ClassFeatureChoices?.GetValueOrDefault("advance_spellcasting")?.FirstOrDefault() ?? "")"
                                    @onchange="(e) => { var v = e.Value?.ToString(); if (!string.IsNullOrEmpty(v)) SetAdvanceSpellcastingChoice(index, v); }">
                                <option value="">Select class to advance...</option>
                                @foreach (var (classId, sc) in casterInfo.Spellcasting)
                                {
                                    <option value="@classId">@classId.Replace("class:", "") (@sc.CastingType CL @sc.CasterLevel)</option>
                                }
                            </select>
                        </div>
                    }

                    @* Specialist wizard schools — offered on the tick that grants the picks (1st
                       wizard level). Specializing is optional; a wizard who picks nothing is a
                       universalist and keeps every school. *@
                    var schoolPicks = _tickWizardSchoolPicks.GetValueOrDefault(index);
                    // How many schools must be given up is a function of the specialty, not of the
                    // grant: the class grants a flat count of 2, but a diviner owes only one and a
                    // universalist none. Driving the picker off the grant offered a diviner a
                    // second slot it could fill illegally, and offered a universalist two.
                    var specialtyPick = SelectedSchool(tick, WizardSchools.SpecializationFeature, 0);
                    var specialtyName = specialtyPick is null ? null : WizardSchools.ToSchoolName(specialtyPick);
                    var requiredProhibited = WizardSchools.RequiredProhibitedCount(specialtyName);
                    var prohibitedChosen = ChosenProhibitedCount(tick, requiredProhibited);
                    @if (schoolPicks is { PendingSpecialization: true } or { PendingProhibited: > 0 })
                    {
                        <div class="mt-2 p-2 border rounded bg-light">
                            <div><small class="text-muted"><strong>Arcane school</strong> — chosen once, at 1st wizard level.</small></div>
                            <div class="d-flex flex-wrap gap-2 mt-1 align-items-center">
                                <select class="form-select form-select-sm" style="max-width:260px"
                                        value="@(specialtyPick ?? "")"
                                        @onchange="(e) => SetWizardSchool(index, WizardSchools.SpecializationFeature, 0, e.Value?.ToString())">
                                    <option value="">Universalist (no specialty)</option>
                                    @foreach (var opt in SchoolOptions(WizardSchools.SpecializationFeature))
                                    {
                                        <option value="@opt.Id" title="@opt.Description">@opt.Name</option>
                                    }
                                </select>
                                @for (int slot = 0; slot < requiredProhibited; slot++)
                                {
                                    var capturedSlot = slot;
                                    var thisPick = SelectedSchool(tick, WizardSchools.ProhibitedFeature, capturedSlot);
                                    <select class="form-select form-select-sm @(string.IsNullOrEmpty(thisPick) ? "border-warning" : "")"
                                            style="max-width:260px"
                                            value="@(thisPick ?? "")"
                                            @onchange="(e) => SetWizardSchool(index, WizardSchools.ProhibitedFeature, capturedSlot, e.Value?.ToString())">
                                        <option value="">Give up a school...</option>
                                        @foreach (var opt in ProhibitedSchoolOptions(tick, specialtyPick, capturedSlot))
                                        {
                                            <option value="@opt.Id" title="@opt.Description">@opt.Name</option>
                                        }
                                    </select>
                                }
                                @if (prohibitedChosen < requiredProhibited)
                                {
                                    <span class="badge bg-warning text-dark">
                                        @(requiredProhibited - prohibitedChosen) school@((requiredProhibited - prohibitedChosen) == 1 ? "" : "s") still to give up
                                    </span>
                                }
                            </div>
                            <div class="mt-1"><small class="text-muted">
                                @if (specialtyName == null)
                                {
                                    <text>A universalist keeps every school and gives up none.</text>
                                }
                                else if (requiredProhibited == 1)
                                {
                                    <text>A diviner gives up only one school.</text>
                                }
                                else
                                {
                                    <text>A specialist gives up two schools.</text>
                                }
                                Divination can never be given up, and a wizard cannot give up its own
                                specialty, so neither is offered. Spells of a given-up school can never
                                be learned or cast, and are not offered below. Universal spells belong
                                to no school and are never given up.
                            </small></div>
                        </div>
                    }

                    @* Static class-feature choices, such as a ranger's combat style. *@
                    var classFeaturePicks = _tickClassFeaturePicks.GetValueOrDefault(index);
                    @if (classFeaturePicks != null)
                    {
                        @foreach (var featurePick in classFeaturePicks)
                        {
                            <div class="mt-2 p-2 border rounded bg-light">
                                <div><small class="text-muted"><strong>@featurePick.Feature.Name</strong> — @featurePick.Feature.Description</small></div>
                                @for (var slot = 0; slot < featurePick.SlotCount; slot++)
                                {
                                    var capturedSlot = slot;
                                    var currentPick = SelectedClassFeatureOption(tick, featurePick.Feature.Id, capturedSlot);
                                    <select class="form-select form-select-sm mt-1 @(string.IsNullOrEmpty(currentPick) ? "border-warning" : "")"
                                            style="max-width:360px"
                                            value="@(currentPick ?? "")"
                                            @onchange="(e) => SetClassFeatureChoice(index, featurePick.Feature.Id, capturedSlot, e.Value?.ToString())">
                                        <option value="">Select @featurePick.Feature.Name...</option>
                                        @foreach (var option in ClassFeatureOptionsForTick(index, featurePick.Feature.Id, capturedSlot))
                                        {
                                            <option value="@option.Id" title="@option.Description">@option.Name</option>
                                        }
                                    </select>
                                }
                            </div>
                        }
                    }
                    }
                    @* -------------------------- end facet: Summary -------------------------- *@

                    @* -------------------------- facet: Companions -------------------------- *@
                    @if (_activeTab == CharacterTab.Companions)
                    {
                    @* Companion slots granted at this tick — pick species *@
                    var tickSlots = _tickNewCompanionSlots.GetValueOrDefault(index);
                    @if (tickSlots != null)
                    {
                        @foreach (var slot in tickSlots)
                        {
                            var capturedSlot = slot;
                            var featureType = capturedSlot.ClassFeatureType;
                            var featureDef = string.IsNullOrEmpty(featureType)
                                ? null
                                : _classFeatures.FirstOrDefault(f => f.Id == featureType);
                            var currentPick = !string.IsNullOrEmpty(featureType)
                                ? tick.Choices.ClassFeatureChoices?.GetValueOrDefault(featureType)?.FirstOrDefault()
                                : null;
                            var currentTemplate = tick.Choices.CompanionTemplateChoices
                                ?.GetValueOrDefault(capturedSlot.LinkType);
                            var planarTemplates = capturedSlot.LinkType == "animal_companion"
                                ? PlanarAnimalCompanionTemplates().ToList()
                                : new List<TemplateDriver>();
                            <div class="mt-2 p-2 border rounded bg-light">
                                <div>
                                    <small class="text-muted">
                                        Companion slot: <strong>@capturedSlot.LinkType</strong>
                                        granted by @capturedSlot.Granter
                                        — effective level <code>@capturedSlot.EffectiveLevelFormula.Expression</code>
                                    </small>
                                </div>
                                @if (featureDef != null && featureDef.Options.Any())
                                {
                                    <select class="form-select form-select-sm mt-1" style="max-width:360px"
                                            value="@(currentPick ?? "")"
                                            @onchange="(e) => { var v = e.Value?.ToString(); if (!string.IsNullOrEmpty(v)) SetCompanionSpeciesOnTick(index, featureType!, v); }">
                                        <option value="">Pick @capturedSlot.LinkType species...</option>
                                        @foreach (var opt in featureDef.Options)
                                        {
                                            <option value="@opt.Id">@opt.Name</option>
                                        }
                                    </select>
                                }
                                else if (string.IsNullOrEmpty(featureType))
                                {
                                    <div class="mt-1"><small class="text-muted">No species pick — manage via Companions card after Evaluate.</small></div>
                                }
                                else
                                {
                                    <div class="mt-1"><small class="text-danger">No option pool '@featureType' found in content.</small></div>
                                }
                                @if (planarTemplates.Count > 0)
                                {
                                    <label class="form-label small mt-2 mb-0">Planar companion template (optional)</label>
                                    <select class="form-select form-select-sm" style="max-width:360px"
                                            value="@(currentTemplate ?? "")"
                                            @onchange="(e) => SetCompanionTemplateOnTick(index, capturedSlot.LinkType, e.Value?.ToString())">
                                        <option value="">Normal animal</option>
                                        @foreach (var template in planarTemplates)
                                        {
                                            <option value="@template.Id">@template.Name — planar ranger option</option>
                                        }
                                    </select>
                                }
                            </div>
                        }
                    }
                    }
                    @* ------------------------ end facet: Companions ------------------------ *@

                    @* ---------------------------- facet: Spells ---------------------------- *@
                    @if (_activeTab == CharacterTab.Spells)
                    {
                    @* Spellcasting: spell summaries and spell selection *@
                    @if (casterInfo?.Spellcasting.Any() == true)
                    {
                        <div class="mt-2">
                            <div class="small text-muted mb-1">
                                Spells
                                @foreach (var (listId, sc) in casterInfo.Spellcasting)
                                {
                                    <span class="badge bg-info text-dark ms-1">@listId.Replace("class:", "") CL @sc.CasterLevel Lvl @sc.MaxSpellLevel</span>
                                }
                                @if (tick.Choices.SpellSelections?.Any() == true)
                                {
                                    <span class="badge bg-secondary ms-1">@tick.Choices.SpellSelections.Count selected</span>
                                }
                            </div>
                            @* No nested collapse — the tick expander already bounds how much of
                               the spell catalogue gets scanned per render. *@
                                <div class="mt-1 border rounded p-2" style="max-height: 400px; overflow-y: auto;">
                                    @foreach (var (listId, sc) in casterInfo.Spellcasting.OrderBy(kv => kv.Key))
                                    {
                                        var capturedListId = listId;
                                        <div class="mb-2">
                                            <strong>@capturedListId.Replace("class:", "") (@sc.CastingType, @sc.CastingStat, CL @sc.CasterLevel)</strong>
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                <small class="text-muted">Slots:</small>
                                                @foreach (var (lvl, count) in sc.SpellsPerDay.OrderBy(kv => kv.Key))
                                                {
                                                    var domainBonus = sc.DomainBonusSlots.GetValueOrDefault(lvl);
                                                    var specialtyBonus = sc.SpecialtyBonusSlots.GetValueOrDefault(lvl);
                                                    var abilityBonus = sc.AbilityBonusSlots.GetValueOrDefault(lvl);
                                                    <span class="badge bg-light text-dark border"
                                                          title="A = casting-ability slot, D = domain slot, S = specialty school slot">
                                                        Lvl @lvl: @count@(abilityBonus > 0 ? $"+{abilityBonus}A" : "")@(domainBonus > 0 ? $"+{domainBonus}D" : "")@(specialtyBonus > 0 ? $"+{specialtyBonus}S" : "")
                                                    </span>
                                                }
                                            </div>
                                            @if (sc.SpellsKnown != null)
                                            {
                                                <div class="d-flex flex-wrap gap-1 mt-1">
                                                    <small class="text-muted">Known:</small>
                                                    @foreach (var (lvl, count) in sc.SpellsKnown.OrderBy(kv => kv.Key))
                                                    {
                                                        <span class="badge bg-light text-dark border">Lvl @lvl: @count</span>
                                                    }
                                                </div>
                                            }
                                            @if (sc.Acquisition == SpellAcquisition.FullList)
                                            {
                                                <div class="mt-1 small text-muted">
                                                    Knows the entire @capturedListId.Replace("class:", "") list
                                                    (@AvailableSpellCount(capturedListId, sc.MaxSpellLevel) spells up to level @sc.MaxSpellLevel)
                                                    — choose the daily loadout below.
                                                </div>
                                            }
                                            else
                                            {
                                                var isSpellbook = sc.Acquisition == SpellAcquisition.Spellbook;
                                                var chosenForList = _character.Ticks
                                                    .SelectMany(t => t.Choices.SpellSelections ?? Enumerable.Empty<SpellSelection>())
                                                    .Where(s => s.ClassId == capturedListId)
                                                    .ToList();
                                                @* Deduplicate for every kind of chooser. This used to be computed only when
                                                   SpellsKnown was non-null, so a spellbook caster could add the same spell twice. *@
                                                var alreadyChosen = chosenForList.Select(s => s.SpellId).ToHashSet();

                                                @* A specialist wizard can never learn, write down or cast a spell
                                                   from a school it gave up, so those are not offered at all. *@
                                                var barredSchools = _tickProhibitedSchools.GetValueOrDefault(index)
                                                    ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);

                                                if (isSpellbook)
                                                {
                                                    var inBook = chosenForList.Count(s => s.SpellLevel > 0);
                                                    var freeCantrips = _tickAutomaticCantrips.GetValueOrDefault(index);
                                                    <div class="mt-1 small">
                                                        <span class="text-muted">Spellbook:</span>
                                                        <span class="@(inBook > sc.SpellbookLimit ? "text-danger fw-bold" : "text-muted")">
                                                            @inBook / @sc.SpellbookLimit spells of level 1+
                                                        </span>
                                                        <span class="text-muted">
                                                            — plus @freeCantrips 0-level spells, held automatically@(barredSchools.Count > 0 ? " (those of given-up schools excluded)" : "").
                                                        </span>
                                                        @if (sc.SpellbookLimit > inBook)
                                                        {
                                                            <button class="btn btn-sm btn-outline-secondary ms-2"
                                                                    @onclick="() => LearnAllWizardSpells(index, capturedListId)">
                                                                Learn all available
                                                            </button>
                                                        }
                                                    </div>
                                                }

                                                if (barredSchools.Count > 0)
                                                {
                                                    <div class="small text-muted mt-1">
                                                        Given up: @string.Join(", ", barredSchools.OrderBy(s => s, StringComparer.OrdinalIgnoreCase))
                                                        — those spells are not listed.
                                                    </div>
                                                }

                                                @* Level 0 is skipped for a spellbook caster: every cantrip is in the book from
                                                   1st level, so there is nothing to pick. *@
                                                var firstSelectableLevel = sc.Acquisition == SpellAcquisition.Developed
                                                    ? EpicSpellcasting.SpellLevel
                                                    : isSpellbook ? 1 : 0;
                                                @for (int lvl = firstSelectableLevel; lvl <= sc.MaxSpellLevel; lvl++)
                                                {
                                                    var capturedLvl = lvl;
                                                    var spellsAtLevel = _spells
                                                        .Where(s => Content.Registry.TryGetSpellLevelForList(s, capturedListId, out var l) && l == capturedLvl)
                                                        .Where(s => !alreadyChosen.Contains(s.Id))
                                                        .Where(s => !barredSchools.Contains(s.School))
                                                        .OrderBy(s => s.Name)
                                                        .ToList();
                                                    if (spellsAtLevel.Any())
                                                    {
                                                        <div class="mt-1">
                                                            <small class="text-muted">Level @capturedLvl:</small>
                                                            <SearchSelect TItem="SpellDefinition"
                                                                          Items="spellsAtLevel"
                                                                          DisplaySelector="@(s => s.Name)"
                                                                          ValueSelector="@(s => s.Id)"
                                                                          TitleSelector="@(s => SpellTooltip(s))"
                                                                          DescriptionSelector="@(s => SpellTooltip(s))"
                                                                          CssClass="form-control-sm"
                                                                          Placeholder="@(isSpellbook ? "Add to spellbook..." : "Add spell...")"
                                                                          ValueChanged="@((v) => { if (!string.IsNullOrEmpty(v)) AddSpellSelection(index, capturedListId, capturedLvl, v); })" />
                                                        </div>
                                                    }
                                                }
                                            }
                                        </div>
                                    }
                                    @* Domain bonus slots. A domain grants one bonus slot per spell level and exactly one
                                       spell is legal in it — whichever the domain lists at that level — so this is a
                                       statement of fact, not a choice. Read straight from DomainDefinition.BonusSpells,
                                       which is the authoritative side of the link. *@
                                    @foreach (var domainId in (casterInfo.Domains ?? new()).OrderBy(d => d))
                                    {
                                        var capturedDomainId = domainId;
                                        var ownerClassId = casterInfo.DomainOwners.GetValueOrDefault(capturedDomainId);
                                        var domainMaxLevel = ownerClassId != null
                                            && casterInfo.Spellcasting.TryGetValue(ownerClassId, out var ownerSc)
                                            ? ownerSc.MaxSpellLevel : 0;
                                        var domainDef = _domains.FirstOrDefault(d => d.Id == capturedDomainId);
                                        var slots = domainDef == null
                                            ? new List<KeyValuePair<int, string>>()
                                            : domainDef.BonusSpells
                                                .Where(kv => kv.Key <= domainMaxLevel)
                                                .OrderBy(kv => kv.Key)
                                                .ToList();
                                        if (slots.Any())
                                        {
                                            <div class="mb-2">
                                                <strong>@capturedDomainId.Replace("domain:", "") (domain)</strong>
                                                <div class="small text-muted">Bonus slot spells — granted, not chosen:</div>
                                                <ul class="list-unstyled mb-0 small">
                                                    @foreach (var (lvl, spellId) in slots)
                                                    {
                                                        var domainSpell = _spells.FirstOrDefault(s => s.Id == spellId);
                                                        <li title="@(domainSpell == null ? spellId : SpellTooltip(domainSpell))">
                                                            Level @lvl: <strong>@(domainSpell?.Name ?? spellId)</strong>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    }
                                    @* Selected spells display *@
                                    @if (tick.Choices.SpellSelections?.Any() == true)
                                    {
                                        <div class="mt-2 border-top pt-2">
                                            <small class="text-muted">Selected spells:</small>
                                            <div class="mt-1 d-flex flex-wrap gap-1">
                                                @foreach (var selection in tick.Choices.SpellSelections.OrderBy(s => s.ClassId).ThenBy(s => s.SpellLevel).ThenBy(s => s.SpellId))
                                                {
                                                    var sel = selection;
                                                    var spellDef = _spells.FirstOrDefault(s => s.Id == sel.SpellId);
                                                    <span class="badge bg-secondary" title="@(spellDef == null ? sel.SpellId : SpellTooltip(spellDef))">@FormatSpellSelection(sel) <button class="btn-close btn-close-white btn-sm" @onclick="() => RemoveSpellSelection(index, sel)"></button></span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (index == _character.Ticks.Count - 1 && _state != null)
                                    {
                                        @foreach (var (preparedClassId, preparedSc) in _tickCasterInfos.GetValueOrDefault(index)?.Spellcasting
                                            .Where(entry => entry.Value.Acquisition is SpellAcquisition.FullList or SpellAcquisition.Spellbook)
                                            ?? Enumerable.Empty<KeyValuePair<string, TickSpellcastingInfo>>())
                                        {
                                            <div class="mt-2 border-top pt-2">
                                                <small class="text-muted">Daily prepared loadout (@preparedClassId.Replace("class:", "")):</small>
                                                @foreach (var slotKind in Enum.GetValues<PreparedSpellSlotKind>())
                                                {
                                                    var capturedKind = slotKind;
                                                    var kindLabel = PreparedSpellSlotLabel(capturedKind);
                                                    var levels = preparedSc.SpellsPerDay.Keys
                                                        .Concat(preparedSc.DomainBonusSlots.Keys)
                                                        .Concat(preparedSc.SpecialtyBonusSlots.Keys)
                                                        .Distinct()
                                                        .Where(level => PreparedSpellSlotCount(preparedSc, level, capturedKind) > 0)
                                                        .OrderBy(level => level)
                                                        .ToList();
                                                    @foreach (var level in levels)
                                                    {
                                                        var capturedLevel = level;
                                                        var slotCount = PreparedSpellSlotCount(preparedSc, capturedLevel, capturedKind);
                                                        var selected = PreparedSelections(preparedClassId, capturedLevel, capturedKind);
                                                        var options = PreparedSpellOptions(preparedClassId, preparedSc, capturedLevel, capturedKind)
                                                            .ToList();
                                                        <div class="mt-1">
                                                            <small class="text-muted">@kindLabel level @capturedLevel (@selected.Count / @slotCount):</small>
                                                            @foreach (var prepared in selected)
                                                            {
                                                                var capturedPrepared = prepared;
                                                                var preparedDef = _spells.FirstOrDefault(spell => spell.Id == prepared.SpellId);
                                                                <span class="badge bg-secondary ms-1" title="@(preparedDef == null ? prepared.SpellId : SpellTooltip(preparedDef))">
                                                                    @(preparedDef?.Name ?? prepared.SpellId)
                                                                    <button class="btn-close btn-close-white btn-sm" @onclick="() => RemovePreparedSpellSelection(capturedPrepared)"></button>
                                                                </span>
                                                            }
                                                            @if (selected.Count < slotCount && options.Count > 0)
                                                            {
                                                                <SearchSelect TItem="SpellDefinition"
                                                                              Items="options"
                                                                              DisplaySelector="@(spell => spell.Name)"
                                                                              ValueSelector="@(spell => spell.Id)"
                                                                              TitleSelector="@(spell => SpellTooltip(spell))"
                                                                              DescriptionSelector="@(spell => SpellTooltip(spell))"
                                                                              CssClass="form-control-sm ms-1"
                                                                              Placeholder="Prepare a spell..."
                                                                              ValueChanged="@((value) => { if (!string.IsNullOrEmpty(value)) AddPreparedSpellSelection(preparedClassId, capturedLevel, capturedKind, value); })" />
                                                            }
                                                            else if (selected.Count < slotCount)
                                                            {
                                                                <span class="small text-muted ms-1">No legal spells available.</span>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                        </div>
                    }
                    }
                    @* -------------------------- end facet: Spells -------------------------- *@

                    @* ---------------------------- facet: Skills ---------------------------- *@
                    @if (_activeTab == CharacterTab.Skills)
                    {
                    var skillInfo = GetTickSkillInfo(index);
                    var tickAllocCount = tick.Choices.SkillAllocations?.Sum(a => a.HalfRanks) ?? 0;
                    @if (skillInfo != null && _skills.Any())
                    {
                        <div class="mt-2">
                            <div class="small text-muted mb-1">
                                Skills (@(skillInfo.UnspentPoints) pts remaining, max @(skillInfo.MaxHalfRanks / 2.0) ranks)
                                @if (tickAllocCount > 0) { <span class="badge bg-secondary ms-1">@(tickAllocCount / 2.0) allocated</span> }
                            </div>
                            @* No nested collapse: on the Skills tab this table is the whole point
                               of the pane, so hiding it behind a second toggle is pure friction. *@
                                <div class="mt-1 border rounded p-2" style="max-height: 300px; overflow-y: auto;">
                                    <table class="table table-sm table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>Skill</th>
                                                <th style="width:60px">Ranks</th>
                                                <th style="width:80px">This HD</th>
                                                <th style="width:80px"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var skill in _skills)
                                            {
                                                var sid = skill.Id;
                                                var isClass = skillInfo.CurrentTickClassSkills.Contains(sid);
                                                var totalHalfRanks = skillInfo.SkillHalfRanks.GetValueOrDefault(sid);
                                                var thisTickHalfRanks = GetTickSkillAllocation(index, sid);
                                                var atMax = totalHalfRanks >= skillInfo.MaxHalfRanks;
                                                <tr class="@(isClass ? "" : "text-muted")">
                                                    <td title="@skill.Description">
                                                        @skill.Name
                                                        @if (isClass) { <span class="badge bg-success badge-sm ms-1">C</span> }
                                                    </td>
                                                    <td>@(totalHalfRanks / 2.0)</td>
                                                    <td>@(thisTickHalfRanks > 0 ? $"+{thisTickHalfRanks / 2.0}" : "")</td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <button class="btn btn-outline-success py-0 px-1"
                                                                    disabled="@(atMax || skillInfo.UnspentPoints <= 0)"
                                                                    @onclick="() => AddSkillAllocation(index, sid, isClass)">+</button>
                                                            <button class="btn btn-outline-danger py-0 px-1"
                                                                    disabled="@(thisTickHalfRanks <= 0)"
                                                                    @onclick="() => RemoveSkillAllocation(index, sid, isClass)">−</button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                        </div>
                    }
                    }
                    @* -------------------------- end facet: Skills -------------------------- *@
                    } @* end expanded HD details *@
                </div>
            }
            @if (VisibleTickCount(_activeTab) == 0)
            {
                <p class="text-muted mb-0">@EmptyFacetMessage(_activeTab)</p>
            }
        </div>
    </div>
        </div>@* end .reg-builder-main *@
        <aside class="reg-builder-delta">
            @if (_state != null)
            {
                <DeltaPane State="_state" ClassName="DriverName" OnSave="SaveCharacter" OnEvaluate="EvaluateCharacter" />
            }
        </aside>
    </div>@* end .reg-builder-grid *@
    }
    @* =================== end HD TIMELINE — shared by five tabs =================== *@

    @* ============================= TAB: Equipment ============================= *@
    @if (_activeTab == CharacterTab.Equipment)
    {
    <!-- Step 4: Permanent Events -->
    <div class="card mb-3">
        <div class="card-header">
            Permanent Events (@_character.PermanentEvents.Count)
            <button class="btn btn-sm btn-success float-end" @onclick="AddPermanentEvent">+ Add Event</button>
        </div>
        <div class="card-body">
            <small class="text-muted d-block mb-2">Tomes, Wishes, and other permanent effects applied between HD levels.</small>
            @if (!_character.PermanentEvents.Any())
            {
                <p class="text-muted mb-0">No permanent events. Use presets or add a custom event.</p>
            }
            @for (int i = 0; i < _character.PermanentEvents.Count; i++)
            {
                var evtIndex = i;
                var evt = _character.PermanentEvents[evtIndex];
                <div class="border rounded p-2 mb-2">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <label class="form-label mb-0">Before HD</label>
                            <select class="form-select form-select-sm" style="width:80px"
                                    value="@evt.BeforeTick"
                                    @onchange="(e) => { if (int.TryParse(e.Value?.ToString(), out var v)) { evt.BeforeTick = v; OnCharacterChanged(); } }">
                                @for (int t = 0; t <= _character.Ticks.Count; t++)
                                {
                                    <option value="@t">@(t == 0 ? "Start" : $"HD {t + 1}")</option>
                                }
                            </select>
                        </div>
                        <div class="col">
                            @foreach (var buff in evt.Permabuffs)
                            {
                                <span class="badge bg-info me-1">@FormatPermabuff(buff)</span>
                            }
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemovePermanentEvent(evtIndex)">Remove</button>
                        </div>
                    </div>
                    <div class="mt-1 d-flex flex-wrap gap-1">
                        <span class="text-muted me-1" style="font-size:0.8rem">Add:</span>
                        <select class="form-select form-select-sm" style="width:160px"
                                @onchange="(e) => { var v = e.Value?.ToString(); if (!string.IsNullOrEmpty(v)) AddPresetToEvent(evtIndex, v); }">
                            <option value="">Preset...</option>
                            <optgroup label="Tomes (+1 inherent)">
                                @foreach (var ab in Enum.GetValues<Ability>())
                                {
                                    <option value="tome_1_@ab">Tome +1 @ab</option>
                                }
                            </optgroup>
                            <optgroup label="Tomes (+2 inherent)">
                                @foreach (var ab in Enum.GetValues<Ability>())
                                {
                                    <option value="tome_2_@ab">Tome +2 @ab</option>
                                }
                            </optgroup>
                            <optgroup label="Tomes (+5 inherent)">
                                @foreach (var ab in Enum.GetValues<Ability>())
                                {
                                    <option value="tome_5_@ab">Tome +5 @ab</option>
                                }
                            </optgroup>
                            <optgroup label="Other">
                                <option value="wish_inherent">Wish: +1 inherent to ability...</option>
                                <option value="nat_armor_1">+1 Natural Armor</option>
                                <option value="nat_armor_2">+2 Natural Armor</option>
                                <option value="sr_5">+5 Spell Resistance</option>
                            </optgroup>
                        </select>
                        @if (_pendingWishEvent == evtIndex)
                        {
                            <select class="form-select form-select-sm" style="width:100px"
                                    @onchange="(e) => { var v = e.Value?.ToString(); if (!string.IsNullOrEmpty(v) && Enum.TryParse<Ability>(v, out var ab)) { AddAbilityModToEvent(evtIndex, ab, 1); _pendingWishEvent = null; } }">
                                <option value="">Ability...</option>
                                @foreach (var ab in Enum.GetValues<Ability>())
                                {
                                    <option value="@ab">@ab</option>
                                }
                            </select>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Step 5: Equipment -->
    <div class="card mb-3">
        <div class="card-header">
            Equipment (@_character.Equipment.Count)
        </div>
        <div class="card-body">
            <!-- Add from catalog -->
            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                <select class="form-select form-select-sm" style="width:160px"
                        @bind="_equipmentPickerCategory" @bind:after="ResetEquipmentSelection">
                    <option value="weapon">Weapons</option>
                    <option value="armor">Armor</option>
                    <option value="shield">Shields</option>
                    <option value="wondrous">Wondrous</option>
                    <option value="ring">Rings</option>
                    <option value="rod">Rods</option>
                    <option value="staff">Staves</option>
                    <option value="wand">Wands</option>
                    <option value="scroll">Scrolls</option>
                    <option value="potion">Potions</option>
                    <option value="gear">Gear</option>
                    <option value="ammunition">Ammunition</option>
                </select>
                <div style="flex:1 1 240px">
                    <SearchSelect TItem="EquipmentDefinition"
                                  Items="@_equipmentCatalog.Where(e => string.Equals(e.Category.ToString(), _equipmentPickerCategory, StringComparison.OrdinalIgnoreCase))"
                                  Value="@_equipmentPickerSelection"
                                  ValueChanged="@((v) => _equipmentPickerSelection = v ?? string.Empty)"
                                  DisplaySelector="@(e => e.Name + (e.WeightLbs > 0 ? $" — {e.WeightLbs} lb" : ""))"
                                  ValueSelector="@(e => e.Id)"
                                  TitleSelector="@(e => e.Description ?? e.Name)"
                                  DescriptionSelector="@(e => e.Description ?? e.Name)"
                                  CssClass="form-control-sm"
                                  Placeholder="Search equipment..." />
                </div>
                <button class="btn btn-sm btn-success" @onclick="AddCatalogItem" disabled="@string.IsNullOrEmpty(_equipmentPickerSelection)">+ Add</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="AddCustomEquipmentEntry">+ Custom</button>
            </div>

            @if (!_character.Equipment.Any())
            {
                <p class="text-muted mb-0">No equipment. Pick from the catalog above or add a custom item.</p>
            }
            @for (int i = 0; i < _character.Equipment.Count; i++)
            {
                var eqIndex = i;
                var item = _character.Equipment[eqIndex];
                var contentDef = string.IsNullOrEmpty(item.ContentId)
                    ? null
                    : _equipmentCatalog.FirstOrDefault(e => e.Id == item.ContentId);
                <div class="border rounded p-2 mb-2">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            @if (contentDef != null)
                            {
                                <strong>@contentDef.Name</strong>
                                <div class="text-muted small">@contentDef.Category@(contentDef.Slot != null ? $" — {contentDef.Slot}" : "")</div>
                            }
                            else
                            {
                                <input type="text" class="form-control form-control-sm" placeholder="Item name"
                                       @bind="item.ItemId" @bind:after="OnCharacterChanged" />
                            }
                        </div>
                        <div class="col-md-2">
                            <select class="form-select form-select-sm" value="@item.Slot" @onchange="(e) => { item.Slot = e.Value?.ToString() ?? string.Empty; OnCharacterChanged(); }">
                                <option value="">No slot</option>
                                <option value="head">Head</option>
                                <option value="eyes">Eyes</option>
                                <option value="neck">Neck</option>
                                <option value="shoulders">Shoulders</option>
                                <option value="body">Body</option>
                                <option value="torso">Torso</option>
                                <option value="waist">Waist</option>
                                <option value="hands">Hands</option>
                                <option value="ring">Ring</option>
                                <option value="feet">Feet</option>
                                <option value="weapon">Weapon</option>
                                <option value="shield">Shield</option>
                                <option value="slotless">Slotless</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            @if (contentDef?.Category == EquipmentCategory.Weapon)
                            {
                                <div class="form-check form-check-sm">
                                    <input type="checkbox" class="form-check-input" id="mh-@eqIndex"
                                           checked="@item.MainHand" @onchange="(e) => { item.MainHand = (bool)e.Value!; OnCharacterChanged(); }" />
                                    <label class="form-check-label small" for="mh-@eqIndex">Main hand</label>
                                </div>
                                <div class="form-check form-check-sm">
                                    <input type="checkbox" class="form-check-input" id="th-@eqIndex"
                                           checked="@item.TwoHanded" @onchange="(e) => { item.TwoHanded = (bool)e.Value!; OnCharacterChanged(); }" />
                                    <label class="form-check-label small" for="th-@eqIndex">Two-handed</label>
                                </div>
                            }
                        </div>
                        <div class="col">
                            @if (contentDef != null)
                            {
                                @foreach (var buff in contentDef.GrantedPermabuffs)
                                {
                                    <span class="badge bg-info me-1">@FormatPermabuff(buff)</span>
                                }
                                @if (contentDef.Weapon != null)
                                {
                                    <span class="badge bg-secondary me-1">@contentDef.Weapon.Damage @contentDef.Weapon.DamageType</span>
                                    @if (contentDef.EnhancementBonus != 0)
                                    {
                                        <span class="badge bg-info me-1">@(contentDef.EnhancementBonus > 0 ? "+" : "")@contentDef.EnhancementBonus enhancement</span>
                                    }
                                }
                                @if (contentDef.Armor != null)
                                {
                                    <span class="badge bg-secondary me-1">@contentDef.Armor.Kind +@contentDef.Armor.ArmorBonus</span>
                                }
                            }
                            @foreach (var buff in item.Permabuffs)
                            {
                                <span class="badge bg-info me-1">@FormatPermabuff(buff)</span>
                            }
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveEquipmentEntry(eqIndex)">Remove</button>
                        </div>
                    </div>
                    @if (contentDef == null)
                    {
                        <div class="mt-1 d-flex flex-wrap gap-1">
                            <span class="text-muted me-1" style="font-size:0.8rem">Add effect:</span>
                            <select class="form-select form-select-sm" style="width:180px"
                                    @onchange="(e) => { var v = e.Value?.ToString(); if (!string.IsNullOrEmpty(v)) AddEquipmentEffect(eqIndex, v); }">
                                <option value="">Effect...</option>
                                <optgroup label="Ability Bonus">
                                    @foreach (var ab in Enum.GetValues<Ability>())
                                    {
                                        <option value="ability_2_@ab">+2 @ab</option>
                                        <option value="ability_4_@ab">+4 @ab</option>
                                        <option value="ability_6_@ab">+6 @ab</option>
                                    }
                                </optgroup>
                                <optgroup label="Armor">
                                    @for (int n = 1; n <= 5; n++)
                                    {
                                        var val = n;
                                        <option value="nat_armor_@val">+@val Natural Armor</option>
                                    }
                                </optgroup>
                                <optgroup label="Resistance">
                                    @for (int n = 1; n <= 5; n++)
                                    {
                                        var val = n;
                                        <option value="save_resist_@val">+@val Resistance (saves)</option>
                                    }
                                </optgroup>
                                <optgroup label="Spell Resistance">
                                    <option value="sr_13">SR 13</option>
                                    <option value="sr_17">SR 17</option>
                                    <option value="sr_21">SR 21</option>
                                </optgroup>
                            </select>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    }
    @* =========================== end TAB: Equipment =========================== *@

    @* The old single "Evaluation Result" card is split across the tabs its blocks belong to,
       so each pane shows the readout for the decisions made on that pane. *@
    @if (_state != null)
    {
        @if (_activeTab == CharacterTab.Summary)
        {
        <div class="card mb-3">
            <div class="card-header">Evaluation Result</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <h5>Combat</h5>
                        <p>HP: @_state.HP | BAB: +@_state.EffectiveBAB</p>
                        <p>AC: @_state.AC.Total | Touch @_state.AC.Touch | FF @_state.AC.FlatFooted</p>
                        <p>Fort: +@_state.EffectiveSaves.Fort | Ref: +@_state.EffectiveSaves.Ref | Will: +@_state.EffectiveSaves.Will</p>
                    </div>
                    <div class="col-md-3">
                        <h5>Abilities</h5>
                        @foreach (var ab in Enum.GetValues<Ability>())
                        {
                            @* A nonability is an absence, not a zero — an undead has no
                               Constitution and an incorporeal creature no Strength. Same
                               rendering as the sheet. *@
                            if (_state.HasAbility(ab))
                            {
                                var score = _state.AbilityScores.GetScore(ab);
                                var mod = _state.AbilityModifier(ab);
                                <span>@ab: @score (@(mod >= 0 ? "+" : "")@mod) </span>
                            }
                            else
                            {
                                <span>@ab: — </span>
                            }
                        }
                    </div>
                    <div class="col-md-3">
                        <h5>Info</h5>
                        <p>HD: @_state.TotalHD | ECL: @_state.ECL | Skills: @_state.UnspentSkillPoints pts</p>
                    </div>
                    @* Speeds are racial/class facts, so they sit here rather than with the gear
                       readout they used to share a column with. *@
                    @if (_state.Speeds.Any())
                    {
                        <div class="col-md-3">
                            <h5>Movement</h5>
                            <div class="small">
                                @foreach (var (mode, speed) in _state.Speeds.OrderBy(entry => entry.Key))
                                {
                                    <div>
                                        @mode: @speed ft.@(mode == MovementMode.Fly && _state.FlyManeuverability.HasValue
                                            ? $" ({_state.FlyManeuverability.Value})"
                                            : "")
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (_state.Warnings.Any())
                {
                    <div class="alert alert-warning mt-2">
                        @foreach (var w in _state.Warnings)
                        {
                            @* Render the message, not the object. CharacterState.Warnings became
                               List<Warning> and this read site kept interpolating the instance, so
                               every warning printed as its type name. *@
                            <div>
                                @if (w.TickIndex.HasValue)
                                {
                                    <span class="badge bg-warning text-dark me-1">HD @w.TickIndex</span>
                                }
                                @w.Message
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        }

        @if (_activeTab == CharacterTab.Feats)
        {
        <div class="card mb-3">
            <div class="card-header">Resulting Feats &amp; Special Abilities</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12">
                        <h5>Feats (@_state.Feats.Count)</h5>
                        @foreach (var f in _state.Feats) {
                            var fd = _feats.FirstOrDefault(x => x.Id == f);
                            <span class="badge bg-secondary me-1" title="@(fd?.Description ?? f)">@(fd?.Name ?? f)</span>
                        }
                        @if (_state.PendingFeatSlots > 0) { <span class="badge bg-warning">@_state.PendingFeatSlots unspent</span> }
                    </div>
                </div>
                @if (_state.Abilities.Any() || _state.Counters.Any() || _state.SLAs.Any() || _state.SpecialAttacks.Any())
                {
                    <div class="row mt-2">
                        @if (_state.Abilities.Any())
                        {
                            <div class="col-md-4">
                                <h5>Special Abilities</h5>
                                @foreach (var a in _state.Abilities)
                                {
                                    <span class="badge bg-info me-1" title="@a.Description">@a.Name</span>
                                }
                            </div>
                        }
                        @if (_state.Counters.Any())
                        {
                            <div class="col-md-4">
                                <h5>Scaling Features</h5>
                                @foreach (var c in _state.Counters)
                                {
                                    <span class="badge bg-secondary me-1">@FormatCounter(c.Key, c.Value)</span>
                                }
                            </div>
                        }
                        @* Spell-like abilities are granted, not chosen, so they belong with the
                           other special abilities rather than on the Spells tab. *@
                        @if (_state.SLAs.Any())
                        {
                            <div class="col-md-4">
                                <h5>Spell-Like Abilities</h5>
                                @foreach (var sla in _state.SLAs)
                                {
                                    <span class="badge bg-primary me-1" title="@SlaTooltip(sla)">@sla.Name@(sla.UsesPerDay != null ? $" ({sla.UsesPerDay}/day)" : "")</span>
                                }
                            </div>
                        }
                        @if (_state.SpecialAttacks.Any())
                        {
                            <div class="col-md-4">
                                <h5>Special Attacks</h5>
                                @foreach (var attack in _state.SpecialAttacks)
                                {
                                    <span class="badge bg-danger me-1" title="@attack.Description">@attack.Name@(attack.UsesPerDay != null ? $" ({attack.UsesPerDay})" : "")</span>
                                }
                            </div>
                        }
                    </div>
                }
                @* Defenses: the sheet has shown these since it was written, the builder never did,
                   so racial and template resistances were invisible while actually building. *@
                @if (_state.Resistances.Any() || _state.Immunities.Any()
                     || _state.DamageReduction.Any() || _state.SpellResistance.HasValue)
                {
                    <div class="row mt-2">
                        @if (_state.Resistances.Any())
                        {
                            <div class="col-md-3">
                                <h5>Resistances</h5>
                                @foreach (var r in _state.Resistances.OrderBy(r => r.Key))
                                {
                                    <span class="badge bg-success me-1">@r.Key @r.Value</span>
                                }
                            </div>
                        }
                        @if (_state.Immunities.Any())
                        {
                            <div class="col-md-3">
                                <h5>Immunities</h5>
                                @foreach (var i in _state.Immunities.OrderBy(i => i))
                                {
                                    <span class="badge bg-danger me-1">Immune to @Titleise(i)</span>
                                }
                            </div>
                        }
                        @if (_state.DamageReduction.Any())
                        {
                            <div class="col-md-3">
                                <h5>Damage Reduction</h5>
                                @foreach (var dr in _state.DamageReduction)
                                {
                                    <span class="badge bg-dark me-1">@dr.Value/@dr.BypassedBy</span>
                                }
                            </div>
                        }
                        @if (_state.SpellResistance.HasValue)
                        {
                            <div class="col-md-3">
                                <h5>Spell Resistance</h5>
                                <span class="badge bg-dark">SR @_state.SpellResistance</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        }

        @* AC, attacks and encumbrance are the readout that says whether the gear choices
           worked, so they live with the gear. The Summary keeps the topline AC/HP/BAB. *@
        @if (_activeTab == CharacterTab.Equipment)
        {
            @if (_state.AC.Components.Any() || _state.AttackLines.Any() || _state.Encumbrance.TotalWeightLbs > 0
                 || _state.Encumbrance.HeavyMax > 0)
            {
                <div class="card mb-3">
                    <div class="card-header">Gear Result</div>
                    <div class="card-body">
                        <div class="row">
                            @if (_state.AC.Components.Any())
                            {
                                <div class="col-md-4">
                                    <h5>AC Breakdown</h5>
                                    <div class="small">
                                        <div>Total: <strong>@_state.AC.Total</strong></div>
                                        <div>Touch: @_state.AC.Touch | Flat-Footed: @_state.AC.FlatFooted</div>
                                        @foreach (var c in _state.AC.Components.OrderByDescending(kv => kv.Value))
                                        {
                                            <div>+@c.Value @c.Key</div>
                                        }
                                        @if (_state.AC.DexContribution != 0)
                                        {
                                            <div>@(_state.AC.DexContribution >= 0 ? "+" : "")@_state.AC.DexContribution Dex@(_state.AC.MaxDexCap.HasValue ? $" (cap {_state.AC.MaxDexCap})" : "")</div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (_state.AttackLines.Any())
                            {
                                <div class="col-md-4">
                                    <h5>Attacks</h5>
                                    @foreach (var line in _state.AttackLines)
                                    {
                                        var bonusStr = string.Join("/", line.Bonuses.Select(b => (b >= 0 ? "+" : "") + b));
                                        <div class="small">
                                            <strong>@line.Name@(line.IsOffHand ? " (off-hand)" : "")</strong>: @bonusStr, @line.Damage, @line.Crit
                                        </div>
                                    }
                                </div>
                            }
                            @if (_state.Encumbrance.TotalWeightLbs > 0 || _state.Encumbrance.HeavyMax > 0)
                            {
                                <div class="col-md-4">
                                    <h5>Encumbrance</h5>
                                    <div class="small">
                                        <div><strong>@_state.Encumbrance.TotalWeightLbs lb</strong> — @_state.Encumbrance.Load</div>
                                        <div class="text-muted">Light ≤ @_state.Encumbrance.LightMax · Med ≤ @_state.Encumbrance.MediumMax · Heavy ≤ @_state.Encumbrance.HeavyMax</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        @* ============================ TAB: Companions ============================ *@
        @* Visibility is decided by HasCompanions() in VisibleTabs(); if the tab is active
           it is because that union already held. *@
        @if (_activeTab == CharacterTab.Companions)
        {
            <div class="card mb-3">
                <div class="card-header">Companions</div>
                <div class="card-body">
                    @if (_masterLinks.Length > 0)
                    {
                        <div class="mb-2">
                            @foreach (var m in _masterLinks)
                            {
                                <a href="/builder/@m.Id" class="btn btn-sm btn-outline-secondary me-1">&larr; Back to @m.Name</a>
                            }
                        </div>
                    }

                    @foreach (var slot in _state.CompanionSlots)
                    {
                        var capturedSlot = slot;
                        var existingLink = _character.CompanionLinks
                            .FirstOrDefault(l => l.LinkType == capturedSlot.LinkType);
                        var raceDef = string.IsNullOrEmpty(capturedSlot.SelectedSpecies)
                            ? null
                            : _races.FirstOrDefault(r => r.Id == capturedSlot.SelectedSpecies);
                        var companionChar = existingLink == null ? null : TryLoadCompanion(existingLink.CompanionId);

                        <div class="border rounded p-2 mb-2">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <strong>@capturedSlot.LinkType</strong>
                                <span class="text-muted small">from @capturedSlot.Granter</span>
                                <span class="badge bg-secondary">effective level @capturedSlot.EffectiveLevel</span>
                                @if (!string.IsNullOrEmpty(capturedSlot.SelectedSpecies))
                                {
                                    <span class="badge bg-info">@(raceDef?.Name ?? capturedSlot.SelectedSpecies)</span>
                                }
                            </div>

                            @if (existingLink != null && companionChar != null)
                            {
                                <div class="mt-1 d-flex align-items-center gap-2">
                                    <span>@companionChar.Name</span>
                                    <a href="/builder/@existingLink.CompanionId" class="btn btn-sm btn-outline-primary">Open &rarr;</a>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => UnlinkCompanion(existingLink)">Unlink</button>
                                </div>
                            }
                            else if (existingLink != null)
                            {
                                <div class="mt-1 alert alert-danger py-1 mb-0 d-flex align-items-center gap-2">
                                    <span>Dangling link: '@existingLink.CompanionId' not found.</span>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => UnlinkCompanion(existingLink)">Remove link</button>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(capturedSlot.SelectedSpecies))
                            {
                                <div class="mt-1">
                                    <button class="btn btn-sm btn-success" @onclick="() => CreateCompanionFromSlot(capturedSlot)">
                                        Create @(raceDef?.Name ?? capturedSlot.SelectedSpecies)
                                    </button>
                                </div>
                            }
                            else if (string.IsNullOrEmpty(capturedSlot.ClassFeatureType))
                            {
                                @* Slots without a species pick (leadership cohort) — allow blank-character creation. *@
                                <div class="mt-1">
                                    <button class="btn btn-sm btn-success" @onclick="() => CreateCompanionFromSlot(capturedSlot)">Create blank cohort</button>
                                </div>
                            }
                            else
                            {
                                <div class="mt-1 small text-muted">Pick a species on the HD tick that granted this slot.</div>
                            }

                            @if (existingLink == null && _availableCharacters.Any(c => c.Id != _characterStoreId))
                            {
                                var slotLinkType = capturedSlot.LinkType;
                                var selectedCandidate = _linkCandidateByLinkType.GetValueOrDefault(slotLinkType, "");
                                <div class="mt-1 d-flex align-items-center gap-1">
                                    <small class="text-muted">or link existing:</small>
                                    <select class="form-select form-select-sm" style="max-width:280px"
                                            value="@selectedCandidate"
                                            @onchange="(e) => _linkCandidateByLinkType[slotLinkType] = e.Value?.ToString() ?? string.Empty">
                                        <option value="">Pick a character...</option>
                                        @foreach (var c in _availableCharacters.Where(c => c.Id != _characterStoreId))
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    </select>
                                    <button class="btn btn-sm btn-outline-primary"
                                            disabled="@string.IsNullOrEmpty(selectedCandidate)"
                                            @onclick="() => LinkExistingCompanion(capturedSlot)">Link</button>
                                </div>
                            }
                        </div>
                    }

                    @if (_state.Feats.Contains("feat:leadership"))
                    {
                        <div class="border rounded p-2 mb-2">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <strong>Leadership</strong>
                                <span class="badge bg-secondary" title="Character level + Charisma modifier">base @_state.LeadershipScore</span>
                                <span class="badge bg-info text-dark" title="@string.Join("; ", _state.LeadershipModifierNotes)">cohort @_state.LeadershipCohortScore</span>
                                <span class="badge bg-info text-dark" title="@string.Join("; ", _state.LeadershipModifierNotes)">followers @_state.LeadershipFollowerScore</span>
                                <span class="badge bg-light text-dark">max cohort level @_state.MaxCohortLevel</span>
                            </div>
                            <div class="form-text mb-1">
                                The SRD modifier table gives a leader two different effective scores:
                                reputation counts whoever is being recruited, the rest applies to cohorts
                                or to followers but not both.
                            </div>
                            <details class="mb-2" open>
                                <summary class="small text-muted">Leadership modifiers (campaign judgement)</summary>
                                <div class="d-flex flex-wrap gap-3 mt-1">
                                    @foreach (var row in LeadershipModifierRows)
                                    {
                                        var capturedLabel = row.Label;
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="@($"lead-{capturedLabel.GetHashCode()}")"
                                                   checked="@GetLeadershipFlag(capturedLabel)"
                                                   @onchange="e => SetLeadershipFlag(capturedLabel, (bool)(e.Value ?? false))" />
                                            <label class="form-check-label small" for="@($"lead-{capturedLabel.GetHashCode()}")">
                                                @capturedLabel
                                                <span class="text-muted">@(row.Group == "followers" ? " — followers only" : "")</span>
                                            </label>
                                        </div>
                                    }
                                    <div class="d-flex align-items-center gap-1">
                                        <label class="small" for="lead-cohort-deaths">Cohorts caused to die (-2 each, cohort only)</label>
                                        <input id="lead-cohort-deaths" type="number" min="0" class="form-control form-control-sm"
                                               style="width:5rem"
                                               value="@_character.LeadershipModifiers.CohortDeathsCaused"
                                               @onchange="e => SetCohortDeaths(int.TryParse(e.Value?.ToString(), out var v) ? v : 0)" />
                                    </div>
                                </div>
                                <div class="form-text">
                                    Keeping a familiar, special mount or animal companion (-2) and recruiting a
                                    cohort of a different alignment (-1) are worked out from the character and are
                                    not listed here.
                                </div>
                            </details>
                        </div>
                    }

                    @if (_state.Feats.Contains("feat:leadership")
                        || _character.CompanionLinks.Any(link => link.LinkType is "leadership_follower" or "follower"))
                    {
                        var followerLinks = _character.CompanionLinks
                            .Where(link => link.LinkType is "leadership_follower" or "follower")
                            .ToArray();
                        var followerCapacity = FollowerCapacity(_leadershipFollowerLevel);
                        var followersAtLevel = FollowersLinkedAt(_leadershipFollowerLevel);
                        <div class="border rounded p-2 mb-2">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <strong>Leadership followers</strong>
                                <span class="badge bg-info text-dark" title="@string.Join("; ", _state.LeadershipModifierNotes)">follower score @_state.LeadershipFollowerScore</span>
                                @for (var level = 1; level <= HighestFollowerLevel(); level++)
                                {
                                    <span class="badge @(FollowersLinkedAt(level) > FollowerCapacity(level) ? "bg-danger" : "bg-light text-dark")"
                                          title="ECL @level — @FollowersLinkedAt(level) linked of @FollowerCapacity(level)">
                                        L@level: @FollowersLinkedAt(level)/@FollowerCapacity(level)
                                    </span>
                                }
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
                                <label class="small" for="leadership-follower-level">Follower level</label>
                                <select id="leadership-follower-level" class="form-select form-select-sm" style="width:auto"
                                        @bind="_leadershipFollowerLevel">
                                    @for (var level = 1; level <= HighestFollowerLevel(); level++)
                                    {
                                        <option value="@level">@level (@FollowersLinkedAt(level) of @FollowerCapacity(level) filled)</option>
                                    }
                                </select>
                                <span class="small text-muted">@followersAtLevel / @followerCapacity linked</span>
                                <button class="btn btn-sm btn-success"
                                        disabled="@(followerCapacity <= followersAtLevel)"
                                        @onclick="() => CreateLeadershipFollower(_leadershipFollowerLevel)">Create blank follower</button>
                            </div>
                            @if (_availableCharacters.Any(c => c.Id != _characterStoreId))
                            {
                                <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
                                    <small class="text-muted">or link existing:</small>
                                    <select class="form-select form-select-sm" style="max-width:280px" @bind="_leadershipFollowerCandidate">
                                        <option value="">Pick a character...</option>
                                        @foreach (var c in _availableCharacters.Where(c => c.Id != _characterStoreId))
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    </select>
                                    <button class="btn btn-sm btn-outline-primary"
                                            disabled="@(string.IsNullOrEmpty(_leadershipFollowerCandidate) || followerCapacity <= followersAtLevel)"
                                            @onclick="LinkExistingLeadershipFollower">Link</button>
                                </div>
                            }
                            @foreach (var followerLink in followerLinks)
                            {
                                var capturedFollower = followerLink;
                                var followerCharacter = TryLoadCompanion(capturedFollower.CompanionId);
                                <div class="small d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <span class="badge bg-info">@(capturedFollower.FollowerLevel > 0 ? $"level {capturedFollower.FollowerLevel}" : "level unknown")</span>
                                    <span>@(followerCharacter?.Name ?? capturedFollower.CompanionId)</span>
                                    @if (followerCharacter != null)
                                    {
                                        <a href="/builder/@capturedFollower.CompanionId" class="btn btn-sm btn-outline-primary">Open &rarr;</a>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => UnlinkCompanion(capturedFollower)">Unlink</button>
                                </div>
                            }
                        </div>
                    }

                    @* Existing links whose LinkType no longer appears as an active slot. *@
                    @foreach (var orphan in _character.CompanionLinks.Where(l => l.LinkType is not ("leadership_follower" or "follower")
                                 && !_state.CompanionSlots.Any(s => s.LinkType == l.LinkType)))
                    {
                        var capturedOrphan = orphan;
                        var companionChar = TryLoadCompanion(capturedOrphan.CompanionId);
                        <div class="border rounded p-2 mb-2 border-warning">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <strong>@capturedOrphan.LinkType</strong>
                                <span class="text-warning small">(no granting slot on master)</span>
                                @if (companionChar != null)
                                {
                                    <span>@companionChar.Name</span>
                                    <a href="/builder/@capturedOrphan.CompanionId" class="btn btn-sm btn-outline-primary">Open &rarr;</a>
                                }
                                else
                                {
                                    <span class="text-danger">'@capturedOrphan.CompanionId' not found</span>
                                }
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => UnlinkCompanion(capturedOrphan)">Unlink</button>
                            </div>
                        </div>
                    }

                    @if (_companionBuilds != null && _companionBuilds.Any())
                    {
                        <div class="mt-2">
                            <small class="text-muted">Composite evaluation:</small>
                            @foreach (var build in _companionBuilds)
                            {
                                <div class="small">
                                    @build.Character.Name —
                                    HD @build.State.TotalHD,
                                    HP @build.State.HP,
                                    BAB +@build.State.EffectiveBAB,
                                    effective master level @build.State.EffectiveMasterLevel
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
}
